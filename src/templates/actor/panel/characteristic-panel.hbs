<div class="dh-panel dh-grid-col-4 dh-grid-row-2">
    <h1 class="dh-panel__header">Characteristics</h1>
    <div class="dh-chartable">
        <div class="dh-chartable__cell--noborder">&nbsp;</div>
        <div class="dh-chartable__cell--left">Initial</div>
        <div class="dh-chartable__cell--left">Advances</div>
        <div class="dh-chartable__cell--left">Modifier</div>
        <div class="dh-chartable__cell--left">Current</div>
        <div class="dh-chartable__cell--left">Unnatural</div>
        <div class="dh-chartable__cell--left">Bonus</div>
        {{#each actor.characteristics as |characteristic name|}}
            <div class="dh-chartable__cell--head {{colorCode this.has_bonus this.has_negative}}">
                <button
                    class="roll-characteristic actor-drag"
                    type="button"
                    data-item-type="characteristic"
                    data-item-id="{{name}}"
                    data-characteristic="{{name}}"
                >{{this.short}}</button>
            </div>
            <div class="dh-chartable__cell {{colorCode this.has_bonus this.has_negative}}">
                <input name="system.characteristics.{{name}}.base" data-dtype="Number" type="number" value="{{lookup (lookup @root.storedCharacteristics name) 'base'}}" />
            </div>
            <div class="dh-chartable__cell {{colorCode this.has_bonus this.has_negative}}">
                <select name="system.characteristics.{{name}}.advance">
                    {{option "0" (lookup (lookup @root.storedCharacteristics name) 'advance') "None"}}
                    {{option "1" (lookup (lookup @root.storedCharacteristics name) 'advance') "Simple"}}
                    {{option "2" (lookup (lookup @root.storedCharacteristics name) 'advance') "Intermediate"}}
                    {{option "3" (lookup (lookup @root.storedCharacteristics name) 'advance') "Trained"}}
                    {{option "4" (lookup (lookup @root.storedCharacteristics name) 'advance') "Proficient"}}
                    {{option "5" (lookup (lookup @root.storedCharacteristics name) 'advance') "Expert"}}
                </select>
            </div>
            <div class="dh-chartable__cell {{colorCode this.has_bonus this.has_negative}}">
                <input class="dh-field__input" name="system.characteristics.{{name}}.modifier" data-dtype="Number" type="number" value="{{lookup (lookup @root.storedCharacteristics name) 'modifier'}}" />
            </div>
            <div class="dh-chartable__cell dh-chartable__cell--highlight {{colorCode this.has_bonus this.has_negative}}">
                <span class="display">{{this.total}}</span>
            </div>
            <div class="dh-chartable__cell {{colorCode this.has_bonus this.has_negative}}">
                <input class="dh-field__input" name="system.characteristics.{{name}}.unnatural" data-dtype="Number" type="number" value="{{lookup (lookup @root.storedCharacteristics name) 'unnatural'}}" />
            </div>
            <div class="dh-chartable__cell {{colorCode this.has_bonus this.has_negative}}">
                <span class="display">{{this.bonus}}</span>
            </div>
        {{/each}}
    </div>
</div>