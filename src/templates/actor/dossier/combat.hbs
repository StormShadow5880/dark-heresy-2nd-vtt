<section class="tab dossier-tab dossier-tab--combat" data-tab="combat" data-group="primary">
    <article class="panel action-account" data-account>{{> systems/dark-heresy-2nd/templates/actor/dossier/action-account.hbs acct=dossier.account}}</article>
    <article class="panel panel--ornate panel--weapons">
        <h2 class="panel__title">Equipped Weapons
            <button type="button" class="icon-btn item-create" data-type="weapon" data-tooltip="New weapon"><i class="fa-solid fa-plus"></i></button>
        </h2>
        <table class="wtable wtable--full">
            <thead>
                <tr><th>Weapon</th><th>Damage</th><th>Pen</th><th>Range</th><th>RoF</th><th>Clip</th><th>Reload</th><th>Special</th><th></th></tr>
            </thead>
            <tbody>
                {{#each dossier.weapons as |w|}}
                    {{#if w.equipped}}
                        <tr class="item-drag" data-item-id="{{w.id}}" data-item-type="weapon">
                            <td class="wtable__name" data-tooltip="{{w.class}}{{#if w.type}} · {{w.type}}{{/if}}"><img src="{{w.img}}" alt="" /> <span>{{w.name}}</span></td>
                            <td>{{w.damage}} <small>{{w.damageType}}</small></td>
                            <td>{{w.penetration}}</td>
                            <td>{{w.range}}</td>
                            <td>{{w.rateOfFire}}</td>
                            <td>{{#if w.usesAmmo}}{{w.clipValue}}/{{w.clipMax}}{{else}}—{{/if}}</td>
                            <td>{{#if w.usesAmmo}}{{w.reload}}{{else}}—{{/if}}</td>
                            <td class="wtable__sp">{{#each w.specials as |sp|}}{{sp}}{{#unless @last}}, {{/unless}}{{else}}—{{/each}}</td>
                            <td class="wtable__act">
                                <button type="button" class="icon-btn icon-btn--act item-roll" data-item-id="{{w.id}}" data-tooltip="Attack"><i class="fa-solid fa-crosshairs"></i></button>
                                <button type="button" class="icon-btn icon-btn--act item-damage" data-item-id="{{w.id}}" data-tooltip="Damage"><i class="fa-solid fa-burst"></i></button>
                                {{#if w.usesAmmo}}<button type="button" class="icon-btn" data-action="reloadWeapon" data-item-id="{{w.id}}" data-tooltip="Reload"><i class="fa-solid fa-rotate"></i></button>{{/if}}
                                <button type="button" class="icon-btn on" data-action="toggleEquipped" data-item-id="{{w.id}}" data-tooltip="Unequip" aria-pressed="true"><i class="fa-solid fa-hand-fist"></i></button>
                                <button type="button" class="icon-btn item-edit" data-item-id="{{w.id}}" data-tooltip="Edit"><i class="fa-solid fa-pen"></i></button>
                            </td>
                        </tr>
                    {{/if}}
                {{/each}}
                {{#unless dossier.hasEquippedWeapon}}<tr><td colspan="9" class="empty">No weapon equipped. Equip a weapon from the list below or from the Gear tab.</td></tr>{{/unless}}
            </tbody>
        </table>
    </article>

    <div class="combat-layout combat-layout--three">
        <article class="panel panel--defence">
            <h2 class="panel__title">Defence &amp; Movement</h2>
            <div class="defence">
                <button type="button" class="defence__btn combat-control" data-combat-action="dodge">
                    <span class="defence__label">Dodge</span><span class="defence__value">{{#if dossier.combat.dodge}}{{dossier.combat.dodge}}{{else}}—{{/if}}</span>
                </button>
                <button type="button" class="defence__btn combat-control" data-combat-action="parry">
                    <span class="defence__label">Parry</span><span class="defence__value">{{#if dossier.combat.parry}}{{dossier.combat.parry}}{{else}}—{{/if}}</span>
                </button>
                <button type="button" class="defence__btn combat-control" data-combat-action="assign-damage">
                    <span class="defence__label">Take Hit</span><span class="defence__value"><i class="fa-solid fa-burst"></i></span>
                </button>
            </div>
            <dl class="stats stats--compact">
                <div><dt>Initiative</dt><dd>{{dossier.combat.initiativeBase}} + {{dossier.combat.initiativeBonus}} <small>({{dossier.combat.initiativeCharacteristic}})</small></dd></div>
                <div><dt>Wounds</dt><dd>{{dossier.res.wounds.bar.damage}} / {{dossier.res.wounds.max}}{{#if dossier.res.wounds.bar.critical}} <small>+{{dossier.res.wounds.bar.critical}} crit</small>{{/if}}</dd></div>
                <div><dt>Half / Full</dt><dd>{{dossier.combat.movement.half}} / {{dossier.combat.movement.full}} m</dd></div>
                <div><dt>Charge / Run</dt><dd>{{dossier.combat.movement.charge}} / {{dossier.combat.movement.run}} m</dd></div>
                <div><dt>SB / TB</dt><dd>{{dossier.combat.strengthBonus}} / {{dossier.combat.toughnessBonus}}</dd></div>
                <div><dt>WS / BS</dt><dd>{{dossier.combat.weaponSkill}} / {{dossier.combat.ballisticSkill}}</dd></div>
            </dl>
        </article>

        <article class="panel panel--armour">
            <h2 class="panel__title">Armour <span class="panel__hint">Total = armour + toughness bonus + trait</span></h2>
            <div class="armour-strip">
                {{#each dossier.armour as |z|}}
                    <div class="azone azone--{{z.key}}" data-tooltip="{{z.label}}: armour {{z.armour}} + toughness bonus {{z.toughnessBonus}}{{#if z.traitBonus}} + trait {{z.traitBonus}}{{/if}}">
                        <small>{{z.label}}</small><b>{{z.total}}</b>
                    </div>
                {{/each}}
            </div>
            <ul class="rows rows--compact">
                {{#each dossier.equippedArmour as |a|}}
                    <li class="item-drag" data-item-id="{{a.id}}">
                        <img src="{{a.img}}" alt="" />
                        <span class="grow">{{a.name}} <small>{{a.summary}}</small></span>
                        <button type="button" class="icon-btn on" data-action="toggleEquipped" data-item-id="{{a.id}}" data-tooltip="Take off" aria-pressed="true"><i class="fa-solid fa-shield-halved"></i></button>
                        <button type="button" class="icon-btn item-edit" data-item-id="{{a.id}}" data-tooltip="Edit"><i class="fa-solid fa-pen"></i></button>
                    </li>
                {{else}}
                    <li class="empty">No armour worn. Equip armour on the Gear tab.</li>
                {{/each}}
            </ul>
        </article>
        <article class="panel panel--healing">
            <h2 class="panel__title">Healing</h2>
            <div class="healing-actions">
                <button type="button" class="dh-btn" data-action="firstAid" data-tooltip="Medicae test on the targeted token"><i class="fa-solid fa-kit-medical"></i><span>First Aid (Target)</span></button>
                <button type="button" class="dh-btn" data-action="firstAidSelf" data-tooltip="Treat yourself"><i class="fa-solid fa-bandage"></i><span>Treat myself</span></button>
                <button type="button" class="dh-btn" data-action="fateHeal" data-tooltip="Spend 1 Fate Point, heal 1d5 normal damage"><i class="fa-solid fa-star"></i><span>Fate: Heal 1d5</span></button>
            </div>
            {{#if dossier.timers.length}}
                <ul class="healing-timers">
                    {{#each dossier.timers as |t|}}
                        <li class="healing-timers__row is-{{t.state}}"><span>{{t.label}} <small>({{t.hours}} h)</small></span>
                            <b>{{#if t.ready}}{{#if t.text}}{{t.text}}{{else}}ready{{/if}}{{else}}{{t.text}}{{/if}}</b></li>
                    {{/each}}
                </ul>
            {{/if}}
        </article>
    </div>

    <article class="panel panel--stowed">
        <h2 class="panel__title">Other Weapons</h2>
        <table class="wtable wtable--full">
            <thead>
                <tr><th>Weapon</th><th>Damage</th><th>Pen</th><th>Range</th><th>RoF</th><th>Clip</th><th>Reload</th><th>Special</th><th></th></tr>
            </thead>
            <tbody>
                {{#each dossier.weapons as |w|}}
                    {{#unless w.equipped}}
                        <tr class="item-drag is-unequipped" data-item-id="{{w.id}}" data-item-type="weapon">
                            <td class="wtable__name" data-tooltip="{{w.class}}{{#if w.type}} · {{w.type}}{{/if}}"><img src="{{w.img}}" alt="" /> <span>{{w.name}}</span></td>
                            <td>{{w.damage}} <small>{{w.damageType}}</small></td>
                            <td>{{w.penetration}}</td>
                            <td>{{w.range}}</td>
                            <td>{{w.rateOfFire}}</td>
                            <td>{{#if w.usesAmmo}}{{w.clipValue}}/{{w.clipMax}}{{else}}—{{/if}}</td>
                            <td>{{#if w.usesAmmo}}{{w.reload}}{{else}}—{{/if}}</td>
                            <td class="wtable__sp">{{#each w.specials as |sp|}}{{sp}}{{#unless @last}}, {{/unless}}{{else}}—{{/each}}</td>
                            <td class="wtable__act">
                                <button type="button" class="icon-btn" data-action="toggleEquipped" data-item-id="{{w.id}}" data-tooltip="Equip"><i class="fa-solid fa-hand-fist"></i></button>
                                <button type="button" class="icon-btn item-edit" data-item-id="{{w.id}}" data-tooltip="Edit"><i class="fa-solid fa-pen"></i></button>
                                <button type="button" class="icon-btn item-delete" data-item-id="{{w.id}}" data-tooltip="Delete"><i class="fa-solid fa-trash"></i></button>
                            </td>
                        </tr>
                    {{/unless}}
                {{/each}}
                {{#unless dossier.hasStowedWeapon}}<tr><td colspan="9" class="empty">No other weapons.</td></tr>{{/unless}}
            </tbody>
        </table>
    </article>

    <div class="combat-layout">
        <article class="panel panel--conditions">
            <h2 class="panel__title">Conditions &amp; Effects
                <button type="button" class="icon-btn effect-create" data-tooltip="New effect"><i class="fa-solid fa-plus"></i></button>
            </h2>
            <ul class="rows">
                {{#each effects as |effect|}}
                    <li class="{{#if effect.disabled}}is-off{{/if}}">
                        <img src="{{effect.img}}" alt="" />
                        <span class="grow">{{effect.name}}</span>
                        {{#if effect.disabled}}
                            <button type="button" class="icon-btn effect-enable" data-effect-id="{{effect.id}}" data-tooltip="Enable"><i class="fa-solid fa-toggle-off"></i></button>
                        {{else}}
                            <button type="button" class="icon-btn effect-disable on" data-effect-id="{{effect.id}}" data-tooltip="Disable"><i class="fa-solid fa-toggle-on"></i></button>
                        {{/if}}
                        <button type="button" class="icon-btn effect-edit" data-effect-id="{{effect.id}}" data-tooltip="Edit"><i class="fa-solid fa-pen"></i></button>
                        <button type="button" class="icon-btn effect-delete" data-effect-id="{{effect.id}}" data-tooltip="Delete"><i class="fa-solid fa-trash"></i></button>
                    </li>
                {{else}}
                    <li class="empty">No active effects.</li>
                {{/each}}
            </ul>
        </article>

        <article class="panel panel--critical">
            <h2 class="panel__title">Critical Injuries
                <button type="button" class="icon-btn item-create" data-type="criticalInjury" data-tooltip="New critical injury"><i class="fa-solid fa-plus"></i></button>
            </h2>
            <ul class="rows">
                {{#each dossier.criticalInjuries as |injury|}}
                    <li class="item-drag" data-item-id="{{injury.id}}">
                        <img src="{{injury.img}}" alt="" />
                        <span class="grow">{{injury.name}} <small>{{injury.part}} · {{injury.type}}</small></span>
                        <button type="button" class="icon-btn item-edit" data-item-id="{{injury.id}}" data-tooltip="Edit"><i class="fa-solid fa-pen"></i></button>
                        <button type="button" class="icon-btn item-delete" data-item-id="{{injury.id}}" data-tooltip="Delete"><i class="fa-solid fa-trash"></i></button>
                    </li>
                {{else}}
                    <li class="empty">No critical injuries.</li>
                {{/each}}
            </ul>
        </article>
    </div>
</section>
