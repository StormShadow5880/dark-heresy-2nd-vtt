<section class="tab dossier-tab" data-tab="overview" data-group="primary">
    {{#if dossier.fatigue.unconscious}}
        <div class="fatigue-banner {{#if dossier.fatigue.dead}}is-dead{{/if}}" role="alert">
            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
            <span><strong>Fatigue {{dossier.fatigue.stored}}{{#if dossier.fatigue.ignored}} (effect as {{dossier.fatigue.value}}){{/if}} / {{dossier.fatigue.limit}}:</strong> {{dossier.fatigue.text}}{{#unless dossier.fatigue.dead}} <span data-wake-text>{{#if dossier.fatigue.wake.active}}{{#if dossier.fatigue.wake.ready}}Ready to wake up.{{else}}Wakes up in {{dossier.fatigue.wake.text}}.{{/if}}{{/if}}</span> On waking up the fatigue drops by the Toughness Bonus.{{/unless}}</span>
            {{#unless dossier.fatigue.dead}}<button type="button" class="icon-btn" data-action="wakeUp" data-tooltip="Wake up: fatigue drops by the Toughness Bonus"><i class="fa-solid fa-sun"></i> Wake up</button>{{/unless}}
        </div>
    {{/if}}
    <div class="ov2">
        <div class="ov2__main">
            <article class="panel panel--characteristics">
                <h2 class="panel__title">Characteristics</h2>
                <div class="chars">
                {{#each dossier.characteristics as |c|}}
                    <div class="char {{#if c.hasBonus}}char--bonus{{/if}} {{#if c.hasNegative}}char--negative{{/if}} {{#if c.fatigued}}char--fatigued{{/if}} actor-drag" data-item-type="characteristic" data-item-id="{{c.key}}" data-char="{{c.key}}">
                        <button type="button" class="char__edit-toggle" data-action="toggleCharEdit" data-char="{{c.key}}" data-tooltip="Pin details" aria-label="Pin details of {{c.label}}"><i class="fa-solid fa-thumbtack"></i></button>
                        <span class="char__short" data-tooltip="{{c.label}}">{{c.short}}</span>
                        <button type="button" class="char__roll roll-characteristic" data-characteristic="{{c.key}}" data-tooltip="Roll {{c.label}} test (W100 ≤ {{c.total}}){{#if c.fatigued}} · {{c.fatigueTip}}{{/if}}">{{c.total}}</button>
                        <div class="char__foot">
                            <span class="char__bonus" data-tooltip="Bonus = {{c.bonusText}}">Bonus {{c.bonus}}</span>
                            <span class="pips" data-tooltip="Advances: {{c.advanceLabel}}">{{#each c.advancePips as |on|}}<i class="pip {{#if on}}on{{/if}}"></i>{{/each}}</span>
                        </div>
                        <div class="char__pop" role="group" aria-label="{{c.label}} details">
                            <header><b>{{c.label}}</b><span>{{c.total}} <small>Bonus {{c.bonus}}</small></span></header>
                            {{#if c.fromEffects}}<p class="char__note">Includes effects: unnatural {{c.effectiveUnnatural}}. The fields show the stored values.</p>{{/if}}
                            <label data-tooltip="Initial value"><span>Initial</span>
                                <input type="number" data-dtype="Number" name="system.characteristics.{{c.key}}.base" value="{{c.base}}" /></label>
                            <label data-tooltip="Permanent advances (each +5)"><span>Advances</span>
                                <select name="system.characteristics.{{c.key}}.advance">
                                    {{selectOptions @root.dossier.characteristicAdvanceLevels selected=c.advance}}
                                </select></label>
                            <label data-tooltip="Temporary modifier"><span>Modifier</span>
                                <input type="number" data-dtype="Number" name="system.characteristics.{{c.key}}.modifier" value="{{c.modifier}}" /></label>
                            <label data-tooltip="Unnatural characteristic (extra bonus)"><span>Unnatural</span>
                                <input type="number" data-dtype="Number" name="system.characteristics.{{c.key}}.unnatural" value="{{c.unnatural}}" /></label>
                        </div>
                    </div>
                {{/each}}
                </div>
            </article>

            <div class="ov2__pair">
                <article class="panel panel--status">
                    <h2 class="panel__title">Status</h2>
                    <ul class="stat-list">
                        <li class="stat-list__row" data-tooltip="Wounds taken: {{dossier.res.wounds.bar.damage}} of {{dossier.res.wounds.max}}{{#if dossier.res.wounds.bar.critical}}, critical {{dossier.res.wounds.bar.critical}}{{/if}}">
                            <i class="sicon sicon--wounds fa-solid fa-heart-pulse"></i>
                            <span class="stat-list__label">Wounds</span>
                            <span class="stat-list__value">{{dossier.res.wounds.bar.damage}} / {{dossier.res.wounds.max}}</span>
                            <button type="button" class="step" data-action="adjustDamage" data-delta="-1" aria-label="Heal one point">−</button>
                            <button type="button" class="step" data-action="adjustDamage" data-delta="1" aria-label="Take one point of damage">+</button>
                        </li>
                        {{#each dossier.statusTiles as |t|}}
                            <li class="stat-list__row {{#if t.level}}is-{{t.level}}{{/if}} {{#if (eq t.id "fatigue")}}has-extra{{/if}}" data-tooltip="{{t.tooltip}}">
                                <i class="sicon sicon--{{t.id}}"></i>
                                <span class="stat-list__label">{{t.label}}</span>
                                <span class="stat-list__value">{{t.value}}{{#if t.hasEffective}}<small class="stat-list__eff" data-tooltip="The first level of fatigue is stored but has no effect: the effects are calculated as fatigue {{t.effective}}"> → {{t.effective}}</small>{{/if}}</span>
                                {{#if (eq t.id "fatigue")}}<button type="button" class="step" data-action="fateFatigue" data-tooltip="Spend a Fate Point: remove all fatigue" aria-label="Spend a Fate Point to remove all fatigue"><i class="fa-solid fa-star"></i></button>{{/if}}
                                <button type="button" class="step" data-action="adjustValue" data-path="{{t.path}}" data-delta="-1" data-max="{{t.max}}" aria-label="Decrease {{t.label}}">−</button>
                                <button type="button" class="step" data-action="adjustValue" data-path="{{t.path}}" data-delta="1" data-max="{{t.max}}" aria-label="Increase {{t.label}}">+</button>
                            </li>
                        {{/each}}
                    </ul>
                </article>

                <article class="panel panel--reference">
                    <h2 class="panel__title">Combat Reference</h2>
                    <div class="ref">
                        <ul>
                            <li><i class="fa-solid fa-person-running"></i><span>Dodge</span><b>{{#if dossier.combat.dodge}}{{dossier.combat.dodge}}{{else}}—{{/if}}</b></li>
                            <li><i class="fa-solid fa-shield-halved"></i><span>Parry</span><b>{{#if dossier.combat.parry}}{{dossier.combat.parry}}{{else}}—{{/if}}</b></li>
                            <li><i class="fa-solid fa-vest"></i><span>Armour</span><b data-tooltip="Body: armour + toughness bonus">{{dossier.ov.armour}}</b></li>
                            <li><i class="fa-solid fa-shoe-prints"></i><span>Move</span><b>{{dossier.combat.movement.half}} m</b></li>
                        </ul>
                        <ul>
                            <li><i class="fa-solid fa-bolt"></i><span>Initiative</span><b>{{#if dossier.combat.initiativeBonus}}+{{/if}}{{dossier.combat.initiativeBonus}}</b></li>
                            <li><i class="fa-solid fa-angles-right"></i><span>Charge</span><b>{{dossier.combat.movement.charge}} m</b></li>
                            <li><i class="fa-solid fa-gauge-high"></i><span>Run</span><b>{{dossier.combat.movement.run}} m</b></li>
                            <li><i class="fa-solid fa-weight-hanging"></i><span>Encumbrance</span><b class="{{#if dossier.gear.encumbrance.encumbered}}warn{{/if}}">{{dossier.gear.encumbrance.value}} / {{dossier.gear.encumbrance.max}}</b></li>
                        </ul>
                    </div>
                </article>
            </div>

            <div class="ov2__pair">
                <article class="panel panel--quick">
                    <h2 class="panel__title">Key Skills <span class="panel__hint">{{dossier.quickSkills.length}} <button type="button" class="icon-btn" data-action="goTab" data-tab="skills" data-tooltip="Choose key skills on the Skills tab"><i class="fa-solid fa-pen"></i></button></span></h2>
                    <ul class="qs qs--one">
                        {{#each dossier.quickSkills as |s|}}
                            <li class="qs__item {{#if s.fatigued}}is-fatigued{{/if}}" data-tooltip="{{s.label}} · {{s.training}} ({{s.characteristic}})">
                                <span class="qs__name">{{s.label}} <small>{{s.characteristic}}</small></span>
                                <span class="qs__pips">{{#each s.pips as |p|}}<i class="pip {{#if p.filled}}on{{/if}}"></i>{{/each}}</span>
                                <span class="qs__target">{{s.total}}</span>
                                <button type="button" class="icon-btn roll-skill" data-skill="{{s.skillKey}}" data-specialty="{{s.specKey}}" data-tooltip="Roll {{s.label}} (W100 ≤ {{s.total}})"><i class="fa-solid fa-dice-d20"></i></button>
                            </li>
                        {{else}}
                            <li class="empty">No favourite skills. Use the star on the Skills tab.</li>
                        {{/each}}
                    </ul>
                </article>

                <article class="panel panel--eqweapons">
                    <h2 class="panel__title">Equipped Weapons</h2>
                    <table class="wtable">
                        <thead><tr><th>Weapon</th><th>Range</th><th>Damage</th><th>Pen</th><th>Clip</th><th>Special</th><th></th></tr></thead>
                        <tbody>
                            {{#each dossier.weapons as |w|}}
                                {{#if w.equipped}}
                                    <tr class="item-drag" data-item-id="{{w.id}}" data-item-type="weapon">
                                        <td class="wtable__name"><img src="{{w.img}}" alt="" /> <span>{{w.name}}</span></td>
                                        <td>{{w.range}}</td>
                                        <td>{{w.damage}} <small>{{w.damageType}}</small></td>
                                        <td>{{w.penetration}}</td>
                                        <td>{{#if w.usesAmmo}}{{w.clipValue}}/{{w.clipMax}}{{else}}—{{/if}}</td>
                                        <td class="wtable__sp">{{#each w.specials as |sp|}}{{sp}}{{#unless @last}}, {{/unless}}{{else}}—{{/each}}</td>
                                        <td class="wtable__act">
                                            <button type="button" class="icon-btn item-roll" data-item-id="{{w.id}}" data-tooltip="Attack"><i class="fa-solid fa-crosshairs"></i></button>
                                            <button type="button" class="icon-btn item-damage" data-item-id="{{w.id}}" data-tooltip="Damage"><i class="fa-solid fa-burst"></i></button>
                                            <button type="button" class="icon-btn item-edit" data-item-id="{{w.id}}" data-tooltip="Edit"><i class="fa-solid fa-pen"></i></button>
                                        </td>
                                    </tr>
                                {{/if}}
                            {{/each}}
                            {{#unless dossier.hasEquippedWeapon}}<tr><td colspan="7" class="empty">No weapon equipped.</td></tr>{{/unless}}
                        </tbody>
                    </table>
                </article>
            </div>

            <article class="panel panel--effects">
                <h2 class="panel__title">Active Effects &amp; Conditions
                    <button type="button" class="icon-btn effect-create" data-tooltip="New effect"><i class="fa-solid fa-plus"></i></button>
                </h2>
                <ul class="rows rows--compact">
                    {{#each dossier.psychic.sustainedPowers as |p|}}
                        <li>
                            <i class="fa-solid fa-hourglass-half" data-tooltip="Sustained psychic power"></i>
                            <span class="grow">{{p.name}}{{#if p.effectText}} <small>{{p.effectText}}</small>{{/if}}</span>
                            <button type="button" class="icon-btn on" data-action="togglePsychicEffect" data-item-id="{{p.id}}" data-tooltip="End this power"><i class="fa-solid fa-hourglass-end"></i></button>
                        </li>
                    {{/each}}
                    {{#each effects as |effect|}}
                        <li class="{{#if effect.disabled}}is-off{{/if}}">
                            <img src="{{effect.img}}" alt="" />
                            <span class="grow">{{effect.name}}</span>
                            {{#if effect.disabled}}
                                <button type="button" class="icon-btn effect-enable" data-effect-id="{{effect.id}}" data-tooltip="Enable"><i class="fa-solid fa-toggle-off"></i></button>
                            {{else}}
                                <button type="button" class="icon-btn effect-disable on" data-effect-id="{{effect.id}}" data-tooltip="Disable"><i class="fa-solid fa-toggle-on"></i></button>
                            {{/if}}
                            <button type="button" class="icon-btn effect-edit" data-effect-id="{{effect.id}}" data-tooltip="Edit"><i class="fa-solid fa-pen"></i></button>
                        </li>
                    {{/each}}
                    {{#unless dossier.ov.hasEffects}}<li class="empty">No active effects or conditions.</li>{{/unless}}
                </ul>
            </article>
        </div>

        <aside class="ov2__side">
            <article class="panel panel--info">
                <h2 class="panel__title">Quick Info</h2>
                <div class="qi">
                    <div class="qi__line"><span>Influence</span><b>{{dossier.ov.influence}}</b></div>

                    <section class="qi__block">
                        <h3>Aptitudes ({{dossier.aptitudes.length}}) <button type="button" class="icon-btn" data-action="goTab" data-tab="talents" data-tooltip="Show on the Talents tab"><i class="fa-solid fa-pen"></i></button></h3>
                        <p>{{dossier.ov.aptitudeText}}</p>
                    </section>
                    <section class="qi__block">
                        <h3>Key Talents ({{dossier.talents.length}}) <button type="button" class="icon-btn" data-action="goTab" data-tab="talents" data-tooltip="Open the Talents tab"><i class="fa-solid fa-pen"></i></button></h3>
                        <ul>{{#each dossier.ov.talents as |t|}}<li>{{t}}</li>{{else}}<li class="empty">None.</li>{{/each}}</ul>
                    </section>
                    <section class="qi__block">
                        <h3>Traits ({{dossier.traits.length}}) <button type="button" class="icon-btn" data-action="goTab" data-tab="talents" data-tooltip="Open the Talents tab"><i class="fa-solid fa-pen"></i></button></h3>
                        <ul>{{#each dossier.ov.traits as |t|}}<li>{{t}}</li>{{else}}<li class="empty">None.</li>{{/each}}</ul>
                    </section>
                    <section class="qi__block">
                        <h3>Bonuses <button type="button" class="icon-btn" data-action="goTab" data-tab="talents" data-tooltip="Open the Talents tab"><i class="fa-solid fa-pen"></i></button></h3>
                        <ul class="qi__bonus">
                            {{#each dossier.abilities as |ab|}}
                                <li><b>{{ab.source}}:</b> {{ab.name}}{{#if ab.benefit}}<small>{{ab.benefit}}</small>{{/if}}</li>
                            {{else}}<li class="empty">Select home world, background, role and divination in the header.</li>{{/each}}
                        </ul>
                    </section>
                </div>
            </article>
        </aside>
    </div>
</section>
