<header class="dossier-header">
    <div class="shield">
        <div class="shield__portrait">
            <img src="{{actor.img}}" alt="{{actor.name}}" data-edit="img" data-action="editImage" data-tooltip="Change portrait" />
        </div>
        <span class="shield__ribbon">{{#if actor.system.bio.role}}{{actor.system.bio.role}}{{else}}Acolyte{{/if}}</span>
    </div>

    <div class="dossier-identity">
        <p class="record-title"><span>Imperial Personnel Record</span><span class="record-title__sub">Adeptus Administratum · Personnel Archive</span></p>
        <input class="dossier-name" name="name" type="text" value="{{actor.name}}" aria-label="Name" />
        <div class="dossier-bio-fields">
            {{#each dossier.bioFields as |field|}}
                <label class="dossier-field">
                    <span class="dossier-field__label">{{field.label}}</span>
                    <select class="acolyte-{{field.key}}" name="system.bio.{{field.key}}">
                        <option value=""></option>
                        {{selectOptions (arrayToObject field.options) selected=field.value}}
                    </select>
                </label>
            {{/each}}
        </div>
    </div>

    <div class="hwounds" aria-label="Wounds">
        <div class="hwounds__top">
            <span class="hwounds__label">Wounds</span>
            <span class="hwounds__value">
                <input type="number" data-dtype="Number" name="system.wounds.value" value="{{dossier.res.wounds.value}}" aria-label="Wounds" />
                <span>/</span>
                <input type="number" data-dtype="Number" name="system.wounds.max" value="{{dossier.res.wounds.max}}" aria-label="Maximum wounds" />
            </span>
            <span class="hwounds__steps">
                <button type="button" class="step" data-action="adjustValue" data-path="system.wounds.value" data-delta="-1" data-max="{{dossier.res.wounds.max}}" aria-label="Decrease wounds">−</button>
                <button type="button" class="step" data-action="adjustValue" data-path="system.wounds.value" data-delta="1" data-max="{{dossier.res.wounds.max}}" aria-label="Increase wounds">+</button>
            </span>
        </div>
        <div class="wbar" role="progressbar" aria-valuemin="0" aria-valuemax="{{dossier.res.wounds.max}}" aria-valuenow="{{dossier.res.wounds.value}}">
            <div class="wbar__full" style="--inset: {{dossier.res.wounds.barInset}}%"></div>
        </div>
        <div class="hwounds__sub">
            {{#if actor.system.wounds.critical}}<span>Critical <b>{{actor.system.wounds.critical}}</b></span>{{/if}}
            <span>Fatigue <b>{{dossier.res.fatigue.value}} / {{dossier.res.fatigue.max}}</b></span>
            <span>Fate <b>{{dossier.res.fate.value}} / {{dossier.res.fate.max}}</b></span>
        </div>
    </div>

    <div class="banner" data-tooltip="Available experience points">
        <span class="banner__label">Available XP</span>
        <b class="banner__value">{{dossier.development.available}}</b>
    </div>
</header>
