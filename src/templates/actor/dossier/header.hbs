<header class="dossier-header">
    <div class="shield">
        <div class="shield__portrait">
            <img src="{{actor.img}}" alt="{{actor.name}}" data-edit="img" data-action="editImage" data-tooltip="Change portrait" />
        </div>
        <span class="shield__ribbon">{{#if actor.system.bio.role}}{{actor.system.bio.role}}{{else}}Acolyte{{/if}}</span>
    </div>

    <div class="dossier-identity">
        <input class="dossier-name" name="name" type="text" value="{{actor.name}}" aria-label="Name" />
        <div class="dossier-bio-fields">
            {{#each dossier.bioFields as |field|}}
                <label class="dossier-field">
                    <span class="dossier-field__label">{{field.label}}</span>
                    <select class="acolyte-{{field.key}}" name="system.bio.{{field.key}}">
                        <option value=""></option>
                        {{selectOptions (arrayToObject field.options) selected=field.value}}
                    </select>
                </label>
            {{/each}}
        </div>
    </div>

    <div class="hmini" aria-label="Wounds">
        <div class="hmini__top">
            <span class="hmini__label">Wounds</span>
            <span class="hmini__fields" data-tooltip="Wounds taken / maximum wounds">
                <input type="number" class="damage-input" min="0" value="{{dossier.res.wounds.bar.damage}}" aria-label="Wounds taken" />
                <span>/</span>
                <input type="number" data-dtype="Number" name="system.wounds.max" value="{{dossier.res.wounds.max}}" aria-label="Maximum wounds" />
            </span>
            <span class="hmini__steps">
                <button type="button" class="step" data-action="adjustDamage" data-delta="-1" aria-label="Heal one wound" data-tooltip="Heal 1 wound">−</button>
                <button type="button" class="step" data-action="adjustDamage" data-delta="1" aria-label="Take one wound" data-tooltip="+1 wound (beyond the maximum: critical damage)">+</button>
            </span>
        </div>
        <div class="wbar wbar--mini {{#if dossier.res.wounds.bar.serious}}is-serious{{/if}} {{#if dossier.res.wounds.bar.dead}}is-dead{{/if}}" role="progressbar" aria-valuemin="0" aria-valuemax="{{dossier.res.wounds.max}}" aria-valuenow="{{dossier.res.wounds.bar.damage}}">
            <i class="wbar__cap wbar__cap--l"></i>
            <div class="wbar__cells">
                {{#each dossier.res.wounds.bar.cells as |c|}}<i class="wbar__cell {{#if c.filled}}on{{/if}} {{#if c.minor}}minor{{/if}} {{#if c.gap}}gap{{/if}}"></i>{{/each}}
            </div>
            <i class="wbar__cap wbar__cap--r"></i>
        </div>
        {{#if dossier.res.wounds.bar.cells.length}}
            <div class="wzones" data-tooltip="Minor damage: the first 2 × toughness bonus points of damage. Beyond that the character is seriously injured.">
                {{#if dossier.res.wounds.bar.minorCells}}<span class="wzones__minor" style="flex: {{dossier.res.wounds.bar.minorCells}}">Minor · {{dossier.res.wounds.bar.minorLimit}}</span>{{/if}}
                {{#if dossier.res.wounds.bar.seriousCells}}<span class="wzones__serious" style="flex: {{dossier.res.wounds.bar.seriousCells}}">Serious</span>{{/if}}
            </div>
        {{/if}}
        <div class="crit {{#if dossier.res.wounds.bar.dead}}is-dead{{/if}}">
            <span class="crit__label" data-tooltip="Critical damage: damage beyond the maximum wounds. At 10 the character is dead. The injuries are listed on the Combat tab.">Critical</span>
            <span class="crit__pips" role="group" aria-label="Critical damage">
                {{#each dossier.res.wounds.bar.criticalPips as |p|}}<button type="button" class="crit__pip {{#if p.filled}}on{{/if}}" data-action="setCritical" data-level="{{p.level}}" aria-label="Set critical damage to {{p.level}}" aria-pressed="{{p.filled}}"></button>{{/each}}
            </span>
            {{#if dossier.res.wounds.bar.dead}}
                <span class="wstate is-dead">Dead</span>
            {{else if dossier.res.wounds.bar.serious}}
                <span class="wstate is-serious">Seriously injured</span>
            {{else if dossier.res.wounds.bar.hasDamage}}
                <span class="wstate">Minor damage</span>
            {{/if}}
        </div>
    </div>

    <div class="banner" data-tooltip="Available experience points">
        <b class="banner__value">{{dossier.development.available}}</b>
    </div>
</header>
