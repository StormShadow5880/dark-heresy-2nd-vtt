<section class="tab dossier-tab" data-tab="bio" data-group="primary">
    <div class="two-col">
        <article class="note">
            <i class="note__pin" aria-hidden="true"></i>
            <h2 class="note__title">Personal File</h2>
            <div class="note__grid">
                <label><span>Gender</span><input type="text" name="system.bio.gender" value="{{actor.system.bio.gender}}" /></label>
                <label><span>Age</span><input type="text" name="system.bio.age" value="{{actor.system.bio.age}}" /></label>
                <label><span>Build</span><input type="text" name="system.bio.build" value="{{actor.system.bio.build}}" /></label>
                <label><span>Complexion</span><input type="text" name="system.bio.complexion" value="{{actor.system.bio.complexion}}" /></label>
                <label><span>Hair</span><input type="text" name="system.bio.hair" value="{{actor.system.bio.hair}}" /></label>
                <label><span>Size</span>
                    <select name="system.size" data-dtype="Number">{{selectOptions dossier.sizeOptions selected=actor.system.size}}</select></label>
            </div>
        </article>
        <article class="panel">
            <h2 class="panel__title">Personality</h2>
            <div class="panel__body stack-fields">
                <label><span>Quirks</span><textarea name="system.bio.quirks" rows="3">{{actor.system.bio.quirks}}</textarea></label>
                <label><span>Superstition</span><textarea name="system.bio.superstition" rows="3">{{actor.system.bio.superstition}}</textarea></label>
                <label><span>Mementos</span><textarea name="system.bio.mementos" rows="3">{{actor.system.bio.mementos}}</textarea></label>
            </div>
        </article>
        <article class="panel">
            <h2 class="panel__title">Notes</h2>
            <div class="panel__body stack-fields">
                <textarea class="notes" name="system.bio.notes" rows="14" aria-label="Notes">{{actor.system.bio.notes}}</textarea>
            </div>
        </article>
        <article class="panel panel--relations">
            <h2 class="panel__title">Patron &amp; Relationships
                {{#if dossier.isGM}}<button type="button" class="icon-btn" data-action="manageFactions" data-tooltip="Manage the list of factions"><i class="fa-solid fa-landmark"></i></button>{{/if}}
                <button type="button" class="icon-btn" data-action="addFaction" data-tooltip="Add a faction relation"><i class="fa-solid fa-flag"></i></button>
                <button type="button" class="icon-btn" data-action="addContact" data-faction="" data-tooltip="New contact"><i class="fa-solid fa-plus"></i></button>
            </h2>
            <div class="rel-patron" data-patron-drop>
                {{#if dossier.patron}}
                    <img src="{{dossier.patron.img}}" alt="" />
                    <span class="grow"><b>{{dossier.patron.name}}</b>{{#if dossier.patron.faction}} <small>{{dossier.patron.faction}}</small>{{/if}}</span>
                    <button type="button" class="rel-btn" data-action="openPatron" data-id="{{dossier.patron.id}}">Open dossier</button>
                {{else}}<span class="grow empty">No patron.{{#if dossier.isGM}} Drag a patron from the Actors directory here.{{/if}}</span>{{/if}}
                {{#if dossier.isGM}}
                    <select data-patron-assign aria-label="Patron of this character"><option value="">– no patron –</option>
                        {{#each dossier.patronOptions as |p|}}<option value="{{p.id}}" {{#if p.selected}}selected{{/if}}>{{p.name}}</option>{{/each}}</select>
                {{/if}}
            </div>
            {{#if dossier.patron}}
                <div class="rel-patron-stats">
                    <h4>Relations of the patron <small>(used for tests in the patron's name)</small></h4>
                    <ul class="rel-patron-stats__list">
                        {{#each dossier.patron.relations as |r|}}
                            <li><span>{{r.faction}}</span><b>{{#if r.secret}}unknown{{else}}{{signed r.level}} <small>→ {{#if (gt r.modifier 0)}}+{{/if}}{{r.modifier}}</small>{{/if}}</b></li>
                        {{else}}<li class="empty">None.</li>{{/each}}
                    </ul>
                    {{#if dossier.patron.boons.length}}<h4>Boons</h4><ul class="rel-patron-stats__list">{{#each dossier.patron.boons as |b|}}<li><span>{{b.text}}</span></li>{{/each}}</ul>{{/if}}
                    {{#if dossier.patron.liabilities.length}}<h4>Liabilities</h4><ul class="rel-patron-stats__list">{{#each dossier.patron.liabilities as |l|}}<li><span>{{l.text}}</span></li>{{/each}}</ul>{{/if}}
                </div>
            {{/if}}
            <p class="rel-hint">House rule: one relationship level = ±10 on the target of a fitting social test. Faction level + contact value = personal level. In the patron's name the patron's value replaces it.</p>
            <div class="rel-table">
                <div class="rel-row rel-row--head" aria-hidden="true">
                    <span>Faction / contact</span><span>Level</span><span>Calculation</span><span>Modifier</span><span></span><span></span>
                </div>
                {{#each dossier.network.groups as |g|}}
                    <section class="rel-faction" data-faction="{{g.id}}">
                        <div class="rel-row rel-row--faction">
                            <select class="rel-name" data-faction-field="factionId" data-faction-id="{{g.id}}" aria-label="Faction">
                                {{#if g.unlisted}}<option value="" selected>{{#if g.name}}{{g.name}} (not in the list){{else}}– choose a faction –{{/if}}</option>{{/if}}
                                {{#each g.options as |o|}}<option value="{{o.id}}" {{#if o.selected}}selected{{/if}}>{{o.name}}</option>{{/each}}
                            </select>
                            <input type="number" step="1" class="rel-level" data-faction-field="level" data-faction-id="{{g.id}}" value="{{g.level}}" aria-label="Faction level" title="Your relation to this faction" />
                            <span class="rel-calc">faction</span>
                            <span class="rel-mod {{#if (gt g.modifier 0)}}is-pos{{else if (lt g.modifier 0)}}is-neg{{/if}}">{{#if (gt g.modifier 0)}}+{{/if}}{{g.modifier}}</span>
                            <span class="rel-actions">
                                <button type="button" class="rel-btn" data-action="addContact" data-faction="{{g.id}}" data-tooltip="New contact in this faction">+ Contact</button>
                                <button type="button" class="rel-btn" data-action="relationRoll" data-faction="{{g.id}}" data-tooltip="Social test with the faction">Test</button>
                                <button type="button" class="icon-btn" data-action="removeFaction" data-faction="{{g.id}}" aria-label="Remove the faction"><i class="fa-solid fa-trash"></i></button>
                            </span>
                            <span class="rel-details-slot" aria-hidden="true"></span>
                        </div>
                        <ul class="rows">
                            {{#each g.contacts as |c|}}{{> systems/dark-heresy-2nd/templates/actor/dossier/contact-row.hbs c}}{{else}}<li class="empty">No contacts.</li>{{/each}}
                        </ul>
                    </section>
                {{/each}}
                <section class="rel-faction rel-faction--loose">
                    <h3 class="rel-loose">Contacts without a faction</h3>
                    <ul class="rows">
                        {{#each dossier.network.loose as |c|}}{{> systems/dark-heresy-2nd/templates/actor/dossier/contact-row.hbs c}}{{else}}<li class="empty">No contacts.</li>{{/each}}
                    </ul>
                </section>
            </div>
        </article>
        <article class="panel">
            <h2 class="panel__title">Enemies
                <button type="button" class="icon-btn item-create" data-type="enemy" data-tooltip="New enemy"><i class="fa-solid fa-plus"></i></button>
            </h2>
            <ul class="rows">
                {{#each dossier.relations.enemies as |p|}}
                    <li class="item-drag" data-item-id="{{p.id}}"><img src="{{p.img}}" alt="" /><span class="grow">{{p.name}}</span>
                        <button type="button" class="icon-btn item-edit" data-item-id="{{p.id}}"><i class="fa-solid fa-pen"></i></button>
                        <button type="button" class="icon-btn item-delete" data-item-id="{{p.id}}"><i class="fa-solid fa-trash"></i></button></li>
                {{else}}<li class="empty">No enemies.</li>{{/each}}
            </ul>
        </article>
        <article class="panel panel--wide">
            <h2 class="panel__title">Journal
                <button type="button" class="icon-btn item-create" data-type="journalEntry" data-tooltip="New journal entry"><i class="fa-solid fa-plus"></i></button>
            </h2>
            <ul class="rows">
                {{#each dossier.relations.journal as |p|}}
                    <li class="item-drag" data-item-id="{{p.id}}"><img src="{{p.img}}" alt="" /><span class="grow">{{p.name}}</span>
                        <button type="button" class="icon-btn item-edit" data-item-id="{{p.id}}"><i class="fa-solid fa-pen"></i></button>
                        <button type="button" class="icon-btn item-delete" data-item-id="{{p.id}}"><i class="fa-solid fa-trash"></i></button></li>
                {{else}}<li class="empty">No journal entries.</li>{{/each}}
            </ul>
        </article>
    </div>
</section>
