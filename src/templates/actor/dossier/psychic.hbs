<section class="tab dossier-tab dossier-tab--psychic" data-tab="psychic" data-group="primary">
    <div class="two-col two-col--narrow-left">
        <div class="stack">
        <article class="panel">
            <h2 class="panel__title">Psychic Profile</h2>
            <div class="psy-rating" data-tooltip="Current Psy Rating (rating minus sustained powers)">
                <span class="ring ring--psy"><b>{{dossier.psychic.current}}</b><small>PR</small></span>
                <span class="psy-rating__label">Psy Rating {{dossier.psychic.rating}}</span>
            </div>
            <div class="panel__body details">
                <label><span>Psy Rating</span><input type="number" data-dtype="Number" name="system.psy.rating" value="{{actor.system.psy.rating}}" /></label>
                <label><span>Sustained</span><input type="number" data-dtype="Number" name="system.psy.sustained" value="{{actor.system.psy.sustained}}" data-tooltip="Number of powers currently sustained" /></label>
                <label><span>Current PR</span><span class="static strong" data-tooltip="Psy Rating minus sustained powers">{{dossier.psychic.current}}</span></label>
                <label><span>Class</span>
                    <input type="text" name="system.psy.class" value="{{actor.system.psy.class}}" /></label>
                <label><span>Has focus</span><input type="checkbox" name="system.psy.hasFocus" data-dtype="Boolean" {{checked actor.system.psy.hasFocus}} /></label>
                <label><span>Disciplines</span><span class="static">{{#each dossier.psychic.disciplines as |d|}}{{d}}{{#unless @last}}, {{/unless}}{{else}}—{{/each}}</span></label>
            </div>
            <div class="btn-row">
                <button type="button" class="btn" data-action="rollTable" data-table="Psychic Phenomena"><i class="fa-solid fa-burst"></i> Psychic Phenomena</button>
                <button type="button" class="btn btn--danger" data-action="rollTable" data-table="Perils of the Warp"><i class="fa-solid fa-skull"></i> Perils of the Warp</button>
            </div>
            <p class="hint">Tables are drawn from the system compendium. Rules for when to roll them are in the rulebook.</p>
        </article>
        <article class="panel panel--sustained">
            <h2 class="panel__title">Sustained Powers
                <span class="panel__hint">{{dossier.psychic.sustainedPowers.length}} active · current PR {{dossier.psychic.current}}</span>
            </h2>
            <ul class="rows">
                {{#each dossier.psychic.sustainedPowers as |p|}}
                    <li class="item-drag" data-item-id="{{p.id}}">
                        <span class="grow"><b class="strong">{{p.name}}</b>
                            <small>{{p.discipline}} · sustain: {{p.sustainAction}} · PR {{p.pr}}</small>
                            {{#if p.effectText}}<br /><small class="effect-text">{{p.effectText}}</small>{{/if}}
                        </span>
                        <button type="button" class="icon-btn on" data-action="togglePsychicEffect" data-item-id="{{p.id}}" data-tooltip="End this power (gives back the psy rating)"><i class="fa-solid fa-hourglass-end"></i></button>
                        <button type="button" class="icon-btn item-vocalize" data-item-id="{{p.id}}" data-tooltip="Show in chat"><i class="fa-solid fa-comment"></i></button>
                        <button type="button" class="icon-btn item-edit" data-item-id="{{p.id}}" data-tooltip="Edit"><i class="fa-solid fa-pen"></i></button>
                    </li>
                {{else}}
                    <li class="empty">No power is sustained. A successful manifestation of a sustainable power lists it here.</li>
                {{/each}}
            </ul>
        </article>
        </div>

        <article class="panel">
            <h2 class="panel__title">Psychic Powers
                <button type="button" class="icon-btn item-create" data-type="psychicPower" data-tooltip="New psychic power"><i class="fa-solid fa-plus"></i></button>
            </h2>
            <div class="table-scroll">
                <table class="dtable">
                    <thead><tr><th>Power</th><th>Discipline</th><th class="num">XP</th><th>Action</th><th>Sustained</th><th>Damage</th><th></th></tr></thead>
                    <tbody>
                        {{#each dossier.psychic.powers as |p|}}
                            <tr class="item-drag" data-item-id="{{p.id}}">
                                <td class="strong">{{p.name}}{{#if p.subtype}} <small>{{p.subtype}}</small>{{/if}}{{#if p.active}} <span class="pill pill--on" data-tooltip="In effect, sustained">Active</span>{{/if}}</td>
                                <td>{{p.discipline}}</td>
                                <td class="num">{{p.cost}}</td>
                                <td>{{p.action}}</td>
                                <td>{{p.sustained}}</td>
                                <td>{{#if p.isAttack}}{{p.damage}} <small>pen {{p.penetration}}</small>{{else}}—{{/if}}</td>
                                <td class="act actions">
                                    {{#if p.activatable}}<button type="button" class="icon-btn {{#if p.active}}on{{/if}}" data-action="togglePsychicEffect" data-item-id="{{p.id}}" aria-pressed="{{p.active}}" data-tooltip="{{#if p.active}}In effect and sustained - click to end{{else}}Not in effect - click to switch on at the current psy rating{{/if}}"><i class="fa-solid fa-hourglass-half"></i></button>{{/if}}
                                    <button type="button" class="icon-btn item-roll" data-item-id="{{p.id}}" data-tooltip="Manifest (focus power test)"><i class="fa-solid fa-eye"></i></button>
                                    {{#if p.isAttack}}<button type="button" class="icon-btn item-damage" data-item-id="{{p.id}}" data-tooltip="Roll damage"><i class="fa-solid fa-burst"></i></button>{{/if}}
                                    <button type="button" class="icon-btn item-vocalize" data-item-id="{{p.id}}" data-tooltip="Show in chat"><i class="fa-solid fa-comment"></i></button>
                                    <button type="button" class="icon-btn item-edit" data-item-id="{{p.id}}" data-tooltip="Edit"><i class="fa-solid fa-pen"></i></button>
                                    <button type="button" class="icon-btn item-delete" data-item-id="{{p.id}}" data-tooltip="Delete"><i class="fa-solid fa-trash"></i></button>
                                </td>
                            </tr>
                        {{else}}
                            <tr><td colspan="7" class="empty">No psychic powers. Drag powers from the compendium onto the sheet.</td></tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </article>
    </div>
</section>
