<div class="dh-codex">
    {{> systems/dark-heresy-2nd/templates/item/partial/codex-head.hbs}}

    {{#if item.system.hasLevel}}
    <div class="dh-codex__stats">
        {{> systems/dark-heresy-2nd/templates/item/partial/codex-stat.hbs icon="fa-layer-group" label="Level" name="system.level" value=item.system.level number=true}}
    </div>
    {{/if}}

    <div class="dh-codex__facts">
        {{> systems/dark-heresy-2nd/templates/item/partial/codex-check.hbs label="Has Level" name="system.hasLevel" value=item.system.hasLevel}}
        {{> systems/dark-heresy-2nd/templates/item/partial/codex-check.hbs label="Enabled" name="system.enabled" value=item.system.enabled}}
    </div>

    <section class="dh-codex__body dh-body">
        <div class="dh-codex__divider" aria-hidden="true"></div>
        <h2 class="dh-codex__heading"><label for="codex-description-{{item.id}}">Description</label></h2>
        <textarea id="codex-description-{{item.id}}" class="dh-codex__text" name="system.description">{{item.system.description}}</textarea>
    </section>
</div>
