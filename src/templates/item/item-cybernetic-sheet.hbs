<div class="dh-codex">
    {{> systems/dark-heresy-2nd/templates/item/partial/codex-head.hbs}}

    {{#if item.system.hasArmourPoints}}
    <div class="dh-codex__stats dh-codex__stats--six">
        {{> systems/dark-heresy-2nd/templates/item/partial/codex-stat.hbs icon="fa-shield" label="Head" name="system.armourPoints.head" value=item.system.armourPoints.head}}
        {{> systems/dark-heresy-2nd/templates/item/partial/codex-stat.hbs icon="fa-shield" label="L. Arm" name="system.armourPoints.leftArm" value=item.system.armourPoints.leftArm}}
        {{> systems/dark-heresy-2nd/templates/item/partial/codex-stat.hbs icon="fa-shield" label="R. Arm" name="system.armourPoints.rightArm" value=item.system.armourPoints.rightArm}}
        {{> systems/dark-heresy-2nd/templates/item/partial/codex-stat.hbs icon="fa-shield" label="Body" name="system.armourPoints.body" value=item.system.armourPoints.body}}
        {{> systems/dark-heresy-2nd/templates/item/partial/codex-stat.hbs icon="fa-shield" label="L. Leg" name="system.armourPoints.leftLeg" value=item.system.armourPoints.leftLeg}}
        {{> systems/dark-heresy-2nd/templates/item/partial/codex-stat.hbs icon="fa-shield" label="R. Leg" name="system.armourPoints.rightLeg" value=item.system.armourPoints.rightLeg}}
    </div>
    {{/if}}

    <div class="dh-codex__facts">
        {{> systems/dark-heresy-2nd/templates/item/partial/codex-fact.hbs label="Weight" name="system.weight" value=item.system.weight number=true}}
        {{> systems/dark-heresy-2nd/templates/item/partial/codex-fact.hbs label="Availability" name="system.availability" value=item.system.availability options=(arrayToObject dh.items.availability)}}
        {{> systems/dark-heresy-2nd/templates/item/partial/codex-fact.hbs label="Craftsmanship" name="system.craftsmanship" value=item.system.craftsmanship options=(arrayToObject dh.items.craftsmanship)}}
        {{> systems/dark-heresy-2nd/templates/item/partial/codex-check.hbs label="Has Armour Points" name="system.hasArmourPoints" value=item.system.hasArmourPoints}}
        {{> systems/dark-heresy-2nd/templates/item/partial/codex-check.hbs label="Equipped" name="system.equipped" value=item.system.equipped}}
    </div>

    <section class="dh-codex__body dh-body">
        <div class="dh-codex__divider" aria-hidden="true"></div>
        <h2 class="dh-codex__heading"><label for="codex-description-{{item.id}}">Description</label></h2>
        <textarea id="codex-description-{{item.id}}" class="dh-codex__text" name="system.description">{{item.system.description}}</textarea>
    </section>
</div>
