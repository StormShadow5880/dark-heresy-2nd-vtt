<div class="dh-codex">
    {{> systems/dark-heresy-2nd/templates/item/partial/codex-head.hbs plaqueLabel="Tier" plaqueField="system.tier" plaqueValue=item.system.tier}}

    <section class="dh-codex__body dh-body">
        <div class="dh-codex__row">
            <label class="dh-codex__label" for="codex-aptitudes-{{item.id}}">Aptitudes</label>
            <textarea id="codex-aptitudes-{{item.id}}" class="dh-codex__field" name="system.aptitudes" rows="1">{{item.system.aptitudes}}</textarea>
        </div>
        <div class="dh-codex__row">
            <label class="dh-codex__label" for="codex-prereq-{{item.id}}">Prerequisites</label>
            <textarea id="codex-prereq-{{item.id}}" class="dh-codex__field" name="system.prerequisites" rows="1">{{item.system.prerequisites}}</textarea>
        </div>
        <div class="dh-codex__row">
            <label class="dh-codex__label" for="codex-cost-{{item.id}}">XP Cost</label>
            <input id="codex-cost-{{item.id}}" class="dh-codex__field dh-codex__field--short" name="system.cost" type="number" data-dtype="Number" value="{{item.system.cost}}" />
        </div>

        <div class="dh-codex__divider" aria-hidden="true"></div>

        <h2 class="dh-codex__heading"><label for="codex-benefit-{{item.id}}">Benefit</label></h2>
        <textarea id="codex-benefit-{{item.id}}" class="dh-codex__text" name="system.benefit">{{item.system.benefit}}</textarea>
    </section>
</div>
