<div class="dh-codex dh-codex--psychic">
    {{> systems/dark-heresy-2nd/templates/item/partial/codex-head.hbs plaqueText=true plaqueHint="Discipline" plaqueField="system.discipline" plaqueValue=item.system.discipline}}

    <div class="dh-codex__stats">
        {{> systems/dark-heresy-2nd/templates/item/partial/codex-stat.hbs icon="fa-burst" label="Damage" name="system.damage" value=item.system.damage}}
        {{> systems/dark-heresy-2nd/templates/item/partial/codex-stat.hbs icon="fa-bolt" label="Type" name="system.damageType" value=item.system.damageType options=(arrayToObject dh.combat.damage_types)}}
        {{> systems/dark-heresy-2nd/templates/item/partial/codex-stat.hbs icon="fa-shield-halved" label="Pen" name="system.penetration" value=item.system.penetration}}
        {{> systems/dark-heresy-2nd/templates/item/partial/codex-stat.hbs icon="fa-crosshairs" label="Range" name="system.range" value=item.system.range}}
    </div>

    <div class="dh-codex__facts">
        {{> systems/dark-heresy-2nd/templates/item/partial/codex-fact.hbs label="XP Cost" name="system.cost" value=item.system.cost number=true}}
        {{> systems/dark-heresy-2nd/templates/item/partial/codex-fact.hbs label="Prerequisites" name="system.prerequisites" value=item.system.prerequisites}}
        {{> systems/dark-heresy-2nd/templates/item/partial/codex-fact.hbs label="Action" name="system.action" value=item.system.action options=(arrayToObject dh.combat.action_speeds)}}
        {{> systems/dark-heresy-2nd/templates/item/partial/codex-fact.hbs label="Sustained" name="system.sustained" value=item.system.sustained options=(arrayToObject dh.combat.sustained_speeds)}}
        {{> systems/dark-heresy-2nd/templates/item/partial/codex-fact.hbs label="Subtype" name="system.subtype" value=item.system.subtype options=(arrayToObject dh.combat.psychic_subtypes)}}
        {{> systems/dark-heresy-2nd/templates/item/partial/codex-fact.hbs label="Attack" name="system.attackType" value=item.system.attackType options=(arrayToObject dh.combat.psychic_attacks)}}
    </div>

    <div class="dh-codex__divider" aria-hidden="true"></div>

    <nav class="dh-navigation dh-codex__tabs" data-group="primary">
        <label class="dh-navigation__item"><a class="item" data-tab="stats" data-group="primary">Action</a></label>
        <label class="dh-navigation__item"><a class="item" data-tab="description" data-group="primary">Description</a></label>
        <label class="dh-navigation__item"><a class="item" data-tab="effects" data-group="primary">Effects</a></label>
    </nav>

    <section class="dh-codex__body dh-wrapper dh-body">
        <div class="tab" data-group="primary" data-tab="stats">
            <section class="dh-codex__panel">
                <h3 class="dh-codex__panel-title">Manifestation</h3>
                <div class="dh-codex__panel-body">
                    <div class="dh-codex__line"><span>Bonus</span><input class="dh-codex__field" type="text" name="system.target.bonus" value="{{item.system.target.bonus}}" /></div>
                    <div class="dh-codex__line"><span>Use Skill</span><input name="system.target.useSkill" type="checkbox" data-dtype="Boolean" {{checked item.system.target.useSkill}} /></div>
                    {{#if item.system.target.useSkill}}
                    <div class="dh-codex__line"><span>Skill</span><input class="dh-codex__field" type="text" name="system.target.skill" value="{{item.system.target.skill}}" /></div>
                    {{else}}
                    <div class="dh-codex__line"><span>Characteristic</span><select class="dh-codex__field" name="system.target.characteristic">{{selectOptions dh.combat.characteristics selected=item.system.target.characteristic}}</select></div>
                    {{/if}}
                    <div class="dh-codex__line"><span>Is Opposed</span><input name="system.target.isOpposed" type="checkbox" data-dtype="Boolean" {{checked item.system.target.isOpposed}} /></div>
                    <div class="dh-codex__line"><span>Use Opposed Skill</span><input name="system.target.useOpposedSkill" type="checkbox" data-dtype="Boolean" {{checked item.system.target.useOpposedSkill}} /></div>
                    {{#if item.system.target.useOpposedSkill}}
                    <div class="dh-codex__line"><span>Opposed Skill</span><input class="dh-codex__field" type="text" name="system.target.opposedSkill" value="{{item.system.target.opposedSkill}}" /></div>
                    {{else}}
                    <div class="dh-codex__line"><span>Opposed Characteristic</span><select class="dh-codex__field" name="system.target.opposed">{{selectOptions dh.combat.characteristics selected=item.system.target.opposed}}</select></div>
                    {{/if}}
                </div>
            </section>

            <section class="dh-codex__panel">
                <h3 class="dh-codex__panel-title">Attack Specials</h3>
                <div class="dh-codex__panel-body">
                    {{#each item.items as |embedded|}}
                        {{#if embedded.isAttackSpecial}}
                            <div class="dh-codex__trow dh-codex__trow--special item-drag" data-item-id="{{embedded.id}}" data-item-type="{{embedded.type}}">
                                <span><a class="item-edit" data-item-id="{{embedded.id}}" title="Open the item card">{{embedded.name}}</a></span>
                                <span>{{#if embedded.system.enabled}}Enabled{{else}}Off{{/if}}</span>
                                <span>{{defaultVal embedded.system.level 'N/A'}}</span>
                                <span class="dh-codex__tact"><button type="button" class="item-delete" data-item-id="{{embedded.id}}" aria-label="Delete {{embedded.name}}" title="Delete"><i class="fa-solid fa-trash"></i></button></span>
                            </div>
                        {{/if}}
                    {{/each}}
                    <div class="dh-codex__dashed">
                        <em class="dh-codex__none">No attack specials have been added.</em>
                        <button type="button" class="dh-codex__btn item-create" data-type="attackSpecial"><i class="fa-solid fa-plus"></i> Add</button>
                    </div>
                </div>
            </section>

            <section class="dh-codex__panel">
                <h3 class="dh-codex__panel-title">Effects While Sustained</h3>
                <div class="dh-codex__panel-body">
                    <div class="dh-codex__info">
                        <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                        <div>
                            <div class="dh-effect-cards">
                                {{#each effectSummary as |e|}}
                                    <div class="dh-effect-card {{#if e.fixed}}dh-effect-card--fixed{{/if}}" data-tooltip="{{e.characteristic}} · {{e.field}}">
                                        <span class="dh-effect-card__label">{{e.label}}</span>
                                        <span class="dh-effect-card__value">{{e.value}}</span>
                                    </div>
                                {{else}}
                                    <p class="dh-effect-help">This power does not change any values.</p>
                                {{/each}}
                            </div>
                            <p class="dh-effect-state">
                                {{#if canSustain}}Applied after a successful manifestation. The power is sustained ({{item.system.sustained}}) until it is ended and reduces the current psy rating.{{else}}Sustained is "No": the effects are not applied automatically.{{/if}}
                            </p>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="tab" data-group="primary" data-tab="effects">
            <section class="dh-codex__panel">
                <h3 class="dh-codex__panel-title">Effect Definitions</h3>
                <div class="dh-codex__panel-body">
                    {{#if editable}}
                    <p class="dh-effect-help">After a successful manifestation these changes are applied to the psyker as an Active Effect
                        (only for powers that can be sustained, the Sustained field is not "No"). Leave <em>Fixed</em> empty to calculate the
                        value from the psy rating: psy rating ÷ <em>Divide</em>, rounded as selected.</p>
                    <table class="dh-effect-table">
                        <thead>
                            <tr><th>Characteristic</th><th>Field</th><th>Fixed</th><th>PR ÷</th><th>Rounding</th><th></th></tr>
                        </thead>
                        <tbody>
                            {{#each effectRows as |row i|}}
                                <tr>
                                    <td><select name="system.autoEffects.{{i}}.characteristic">{{selectOptions @root.effectCharacteristics selected=row.characteristic}}</select></td>
                                    <td><select name="system.autoEffects.{{i}}.field">{{selectOptions @root.effectFields selected=row.field}}</select></td>
                                    <td><input type="number" data-dtype="Number" name="system.autoEffects.{{i}}.value" value="{{row.value}}" placeholder="from PR" /></td>
                                    <td><input type="number" data-dtype="Number" name="system.autoEffects.{{i}}.pr.divide" value="{{row.pr.divide}}" /></td>
                                    <td><select name="system.autoEffects.{{i}}.pr.round">{{selectOptions @root.effectRounding selected=row.pr.round}}</select></td>
                                    <td><button type="button" data-action="removePsychicEffect" data-index="{{i}}" aria-label="Remove effect">✕</button></td>
                                </tr>
                            {{else}}
                                <tr><td colspan="6">No effects. The power can still be sustained, it just does not change any values.</td></tr>
                            {{/each}}
                        </tbody>
                    </table>
                    <button type="button" class="dh-codex__btn" data-action="addPsychicEffect"><i class="fa-solid fa-plus"></i> Add effect</button>
                    {{/if}}
                </div>
            </section>
        </div>

        <div class="tab" data-group="primary" data-tab="description">
            <section class="dh-codex__panel">
                <h3 class="dh-codex__panel-title"><label for="codex-description-{{item.id}}">Description</label></h3>
                <div class="dh-codex__panel-body">
                    <textarea id="codex-description-{{item.id}}" class="dh-codex__text" name="system.description">{{item.system.description}}</textarea>
                </div>
            </section>
        </div>
    </section>
</div>
