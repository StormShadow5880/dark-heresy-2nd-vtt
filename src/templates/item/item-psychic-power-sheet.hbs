<div class="dh-codex dh-codex--psychic">
    {{> systems/dark-heresy-2nd/templates/item/partial/codex-head.hbs plaqueText=true plaqueHint="Discipline" plaqueField="system.discipline" plaqueValue=item.system.discipline}}

    <div class="dh-codex__facts">
        <label class="dh-codex__fact"><span>XP Cost</span><input class="dh-codex__field" name="system.cost" type="number" data-dtype="Number" value="{{item.system.cost}}" /></label>
        <label class="dh-codex__fact"><span>Prerequisites</span><input class="dh-codex__field" name="system.prerequisites" type="text" value="{{item.system.prerequisites}}" /></label>
        <label class="dh-codex__fact"><span>Range</span><input class="dh-codex__field" name="system.range" type="text" value="{{item.system.range}}" /></label>
        <label class="dh-codex__fact"><span>Action</span><select class="dh-codex__field" name="system.action">{{selectOptions (arrayToObject dh.combat.action_speeds) selected=item.system.action}}</select></label>
        <label class="dh-codex__fact"><span>Sustained</span><select class="dh-codex__field" name="system.sustained">{{selectOptions (arrayToObject dh.combat.sustained_speeds) selected=item.system.sustained}}</select></label>
        <label class="dh-codex__fact"><span>Subtype</span><select class="dh-codex__field" name="system.subtype">{{selectOptions (arrayToObject dh.combat.psychic_subtypes) selected=item.system.subtype}}</select></label>
    </div>

    <div class="dh-navigation dh-codex__tabs" data-group="primary">
        <label class="dh-navigation__item">
            <a class="item" data-tab="stats" data-group="primary">action</a>
        </label>
        <label class="dh-navigation__item">
            <a class="item" data-tab="effects" data-group="primary">effects</a>
        </label>
        <label class="dh-navigation__item">
            <a class="item" data-tab="description" data-group="primary">description</a>
        </label>
    </div>

    <section class="dh-codex__body dh-wrapper dh-body">
                    <div class="tab" data-group="primary" data-tab="stats">
                        <div class="dh-panel dh-grid-col-2 dh-grid-row-1">
                            <h1 class="dh-panel__header">Action</h1>
                            <div class="dh-field__wrapper">
                                <span class="dh-field__header">Bonus</span>
                                <input class="dh-field__input" type="text" name="system.target.bonus"
                                       value="{{item.system.target.bonus}}" />
                            </div>

                            <div class="dh-field__wrapper">
                                <span class="dh-field__header">Use Skill</span>
                                <div class='dh-field__input check'>
                                    <input name="system.target.useSkill" type="checkbox" data-dtype="Boolean" {{checked
                                        item.system.target.useSkill}}/>
                                </div>
                            </div>
                            {{#if item.system.target.useSkill}}
                                <div class="dh-field__wrapper">
                                    <span class="dh-field__header">Skill</span>
                                    <input class="dh-field__input" type="text" name="system.target.skill"
                                           value="{{item.system.target.skill}}" />
                                </div>
                            {{else}}
                                <div class="dh-field__wrapper">
                                    <span class="dh-field__header">Characteristic</span>
                                    <select class="dh-field__input" name="system.target.characteristic">
                                        {{selectOptions dh.combat.characteristics selected=item.system.target.characteristic}}
                                    </select>
                                </div>
                            {{/if}}

                            <div class="dh-field__wrapper">
                                <span class="dh-field__header">Is Opposed</span>
                                <div class='dh-field__input check'>
                                    <input name="system.target.isOpposed" type="checkbox" data-dtype="Boolean" {{checked
                                        item.system.target.isOpposed}}/>
                                </div>
                            </div>
                            <div class="dh-field__wrapper">
                                <span class="dh-field__header">Use Opposed Skill</span>
                                <div class='dh-field__input check'>
                                    <input name="system.target.useOpposedSkill" type="checkbox" data-dtype="Boolean" {{checked
                                        item.system.target.useOpposedSkill}}/>
                                </div>
                            </div>

                            {{#if item.system.target.useOpposedSkill}}
                                <div class="dh-field__wrapper">
                                    <span class="dh-field__header">Opposed Skill</span>
                                    <input class="dh-field__input" type="text" name="system.target.opposedSkill"
                                           value="{{item.system.target.opposedSkill}}" />
                                </div>
                            {{else}}
                                <div class="dh-field__wrapper">
                                    <span class="dh-field__header">Opposed Characteristic</span>
                                    <select class="dh-field__input" name="system.target.opposed">
                                        {{selectOptions dh.combat.characteristics selected=item.system.target.opposed}}
                                    </select>
                                </div>
                            {{/if}}

                        </div>
                        <div class="dh-panel dh-grid-col-2 dh-grid-row-1">
                            <h1 class="dh-panel__header">Damage</h1>
                            <div class="dh-field__wrapper">
                                <span class="dh-field__header">Attack</span>
                                <select class="dh-field__input" name="system.attackType">
                                    {{selectOptions (arrayToObject dh.combat.psychic_attacks)
                                                    selected=item.system.attackType}}
                                </select>
                            </div>
                            <div class="dh-field__wrapper">
                                <span class="dh-field__header">Roll</span>
                                <input class="dh-field__input" type="text" name="system.damage"
                                       value="{{item.system.damage}}" />
                            </div>
                            <div class="dh-field__wrapper">
                                <span class="dh-field__header">Type</span>
                                <select class="dh-field__input" name="system.damageType">
                                    {{selectOptions (arrayToObject dh.combat.damage_types)
                                                    selected=item.system.damageType}}
                                </select>
                            </div>
                            <div class="dh-field__wrapper">
                                <span class="dh-field__header">Pen</span>
                                <input class="dh-field__input" type="text" name="system.penetration"
                                       value="{{item.system.penetration}}" />
                            </div>
                        </div>
                        <div class="dh-panel dh-grid-col-2 dh-grid-row-1">
                            <h1 class="dh-panel__header">Attack Specials</h1>
                            <div class="dh-table--border dh-attackspecialtable--border">
                                <div class="table-row--head">
                                    <div class="table-cell--span2">Name</div>
                                    <div class="table-cell">Enabled</div>
                                    <div class="table-cell">Level</div>
                                    <div class="table-cell--last"></div>
                                </div>
                                {{#each item.items as | embedded |}}
                                    {{#if embedded.isAttackSpecial}}
                                        <div class="table-row">
                                            <div class="table-cell--settingstoggle">
                                                <label class="dh-control-button item-edit"
                                                       data-item-id="{{embedded.id}}">
                                                    <span class="dh-control-button__span material-icons">{{defaultVal
                                                        icon 'settings'}}</span>
                                                </label>
                                            </div>
                                            <div class="table-cell--left">
                                                {{> systems/dark-heresy-2nd/templates/actor/partial/trait-toggle.hbs toggle=(concat 'description_' embedded.id) text=embedded.name}}
                                            </div>
                                            <div class="table-cell">
                                                <span class="display">{{embedded.system.enabled}}</span>
                                            </div>
                                            <div class="table-cell">
                                                <span class="display">{{defaultVal embedded.system.level
                                                                                   'N/A'}}</span>
                                            </div>
                                            <div class="table-cell--last">
                                                <label class="dh-control-button item-delete"
                                                       data-item-id="{{embedded.id}}">
                                                    <span class="dh-control-button__span material-icons">{{defaultVal
                                                        icon 'delete'}}</span>
                                                </label>
                                            </div>
                                            <div class="table-cell--description description_{{embedded.id}}" {{hideIfNot
                                                (isExpanded (concat 'description_' embedded.id ))}}>
                                                <span>{{embedded.system.description}}</span>
                                            </div>
                                        </div>
                                    {{/if}}
                                {{/each}}
                            </div>
                        </div>
                    </div>
                    <div class="tab" data-group="primary" data-tab="effects">
                        <div class="dh-panel dh-grid-col-6">
                            <h1 class="dh-panel__header">While the power is in effect</h1>
                            <div class="dh-effect-cards">
                                {{#each effectSummary as |e|}}
                                    <div class="dh-effect-card {{#if e.fixed}}dh-effect-card--fixed{{/if}}" data-tooltip="{{e.characteristic}} · {{e.field}}">
                                        <span class="dh-effect-card__label">{{e.label}}</span>
                                        <span class="dh-effect-card__value">{{e.value}}</span>
                                    </div>
                                {{else}}
                                    <p class="dh-effect-help">This power does not change any values.</p>
                                {{/each}}
                            </div>
                            <p class="dh-effect-state">
                                {{#if canSustain}}Applied after a successful manifestation. The power is sustained ({{item.system.sustained}}) until it is ended and reduces the current psy rating.{{else}}Sustained is "No": the effects are not applied automatically.{{/if}}
                            </p>
                            {{#if editable}}
                            <p class="dh-effect-help">After a successful manifestation these changes are applied to the psyker as an Active Effect
                                (only for powers that can be sustained, the Sustained field is not "No"). Leave <em>Fixed</em> empty to calculate the
                                value from the psy rating: psy rating ÷ <em>Divide</em>, rounded as selected.</p>
                            <table class="dh-effect-table">
                                <thead>
                                    <tr><th>Characteristic</th><th>Field</th><th>Fixed</th><th>PR ÷</th><th>Rounding</th><th></th></tr>
                                </thead>
                                <tbody>
                                    {{#each effectRows as |row i|}}
                                        <tr>
                                            <td><select name="system.autoEffects.{{i}}.characteristic">{{selectOptions @root.effectCharacteristics selected=row.characteristic}}</select></td>
                                            <td><select name="system.autoEffects.{{i}}.field">{{selectOptions @root.effectFields selected=row.field}}</select></td>
                                            <td><input type="number" data-dtype="Number" name="system.autoEffects.{{i}}.value" value="{{row.value}}" placeholder="from PR" /></td>
                                            <td><input type="number" data-dtype="Number" name="system.autoEffects.{{i}}.pr.divide" value="{{row.pr.divide}}" /></td>
                                            <td><select name="system.autoEffects.{{i}}.pr.round">{{selectOptions @root.effectRounding selected=row.pr.round}}</select></td>
                                            <td><button type="button" data-action="removePsychicEffect" data-index="{{i}}" aria-label="Remove effect">✕</button></td>
                                        </tr>
                                    {{else}}
                                        <tr><td colspan="6">No effects. The power can still be sustained, it just does not change any values.</td></tr>
                                    {{/each}}
                                </tbody>
                            </table>
                            <button type="button" data-action="addPsychicEffect">+ Add effect</button>
                            {{/if}}
                        </div>
                    </div>
                    <div class="tab" data-group="primary" data-tab="description">
                        <div class="dh-header__info dh-grid-col-6">
                            <div class="dh-header__item-wrapper--text-area">
                                <span class="dh-header__title">Description</span>
                                <textarea class="dh-header__textarea" name="system.description">{{item.system.description}}</textarea>
                            </div>
                        </div>
                    </div>
                </section>
</div>
