<div class="dh-ui dh-card dh-card--ornate {{#if success}}dh-card--success{{else}}dh-card--fail{{/if}}">
    <div class="dh-card__eyebrow">Force Field</div>
    <h2 class="dh-card__name">{{forceField.name}}</h2>
    <div class="dh-card__sub">{{actor.name}}</div>
    <div class="dh-rule"></div>
    <div class="dh-badge dh-badge--damage" data-tooltip="Dice result (W100)"><span class="dh-badge__num">{{roll.total}}</span></div>
    <div class="dh-verdict {{#if success}}dh-verdict--success{{else}}dh-verdict--fail{{/if}}">{{#if success}}Success{{else}}Failure{{/if}}</div>
    <p class="dh-detail-line">{{#if success}}The field activates successfully!{{else}}The field fails to protect and the attack proceeds as normal.{{/if}}</p>
    {{#if overload}}
        <p class="dh-note dh-note--alert">The field overloads! It ceases to function until it is recharged or repaired, requiring a successful Very Hard (–30) Tech-Use test.</p>
    {{/if}}
    {{#if forceField.system.description}}
        <p class="dh-note">{{forceField.system.description}}</p>
    {{/if}}
</div>
