<div class="dh-ui dh-card dh-card--ornate {{#if this.hasCriticalDamage}}dh-card--fail{{/if}}">
    <div class="dh-card__eyebrow">{{#if hasDamage}}{{this.hit.location}} Hit{{else}}Status{{/if}}</div>
    <h2 class="dh-card__name">{{this.actor.name}}</h2>
    <div class="dh-rule"></div>
    {{#if this.hasDamage}}
        <div class="dh-badge dh-badge--damage" data-tooltip="Damage taken"><span class="dh-badge__num">{{this.damageTaken}}</span></div>
        <div class="dh-verdict dh-verdict--fail">{{this.hit.damageType}} damage</div>
    {{/if}}
    {{#if this.hasFatigueDamage}}
        <div class="dh-mods dh-mods--center"><span class="dh-mod dh-mod--alert"><b>Fatigue</b> +{{this.fatigueTaken}}</span></div>
    {{/if}}
    {{#if this.hasCriticalDamage}}
        <div class="dh-mods dh-mods--center"><span class="dh-mod dh-mod--alert"><b>Critical damage</b> +{{this.criticalDamageTaken}}</span></div>
        <p class="dh-note dh-note--alert">{{this.criticalEffect}}</p>
    {{/if}}
    <div class="dh-mods dh-mods--center">
        <span class="dh-mod"><b>Wounds</b> {{this.actor.system.wounds.value}} / {{this.actor.system.wounds.max}}</span>
        <span class="dh-mod"><b>Fatigue</b> {{this.actor.system.fatigue.value}} / {{this.actor.system.fatigue.max}}</span>
        <span class="dh-mod"><b>Critical</b> {{this.actor.system.wounds.critical}}</span>
    </div>
</div>
