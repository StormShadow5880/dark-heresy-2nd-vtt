{{#with rollData}}
    <div class="dh-ui dh-card dh-card--info">
        <header class="dh-card__head">
            <span class="dh-card__title">{{name}}</span>
            <span class="dh-card__action">Damage Roll</span>
        </header>
        <div class="dh-card__body">
            <div class="dh-result dh-result--info">
                <span class="dh-result__roll" data-tooltip="Damage">{{roll.total}}</span>
                <span class="dh-result__main">
                    <span class="dh-status dh-status--info">Damage</span>
                    <span class="dh-result__detail">{{damageType}} · Penetration {{penetration}}</span>
                </span>
            </div>
            <div class="dh-mods">
                <span class="dh-mod"><b>Formula</b> {{roll.formula}}</span>
                <span class="dh-mod"><b>Type</b> {{damageType}}</span>
                <span class="dh-mod"><b>Penetration</b> {{penetration}}</span>
            </div>
        </div>
        {{#if targetActor}}
            <footer class="dh-card__foot">
                <button type="button" class="dh-btn dh-btn--primary roll-control__assign-damage"
                        data-location="Body"
                        data-total-damage="{{roll.total}}"
                        data-total-penetration="{{penetration}}"
                        data-target-uuid="{{targetActor.uuid}}"
                        data-damage-type="{{damageType}}">
                    <i class="fa-solid fa-crosshairs"></i><span>Assign Damage</span>
                </button>
            </footer>
        {{/if}}
    </div>
{{/with}}
