{{#with rollData}}
    <div class="dh-ui dh-card dh-card--ornate">
        <div class="dh-card__eyebrow">Damage Roll</div>
        <h2 class="dh-card__name">{{name}}</h2>
        <div class="dh-card__sub">{{damageType}} · Penetration {{penetration}}</div>
        <div class="dh-rule"></div>
        <div class="dh-badge dh-badge--damage" data-tooltip="Damage"><span class="dh-badge__num">{{roll.total}}</span></div>
        <div class="dh-verdict dh-verdict--info">Damage</div>
        <div class="dh-mods dh-mods--center">
            <span class="dh-mod"><b>Formula</b> {{roll.formula}}</span>
            <span class="dh-mod"><b>Type</b> {{damageType}}</span>
            <span class="dh-mod"><b>Pen</b> {{penetration}}</span>
        </div>
        {{#if targetActor}}
            <div class="dh-rule"></div>
            <footer class="dh-card__foot dh-card__foot--center">
                <button type="button" class="dh-btn dh-btn--primary roll-control__assign-damage"
                        data-location="Body"
                        data-total-damage="{{roll.total}}"
                        data-total-penetration="{{penetration}}"
                        data-target-uuid="{{targetActor.uuid}}"
                        data-damage-type="{{damageType}}">
                    <i class="fa-solid fa-crosshairs"></i><span>Assign Damage</span>
                </button>
            </footer>
        {{/if}}
    </div>
{{/with}}
