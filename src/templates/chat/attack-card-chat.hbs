<div class="dh-ui dh-card dh-card--ornate dh-attack">
    <div class="dh-card__eyebrow">{{label}}</div>
    <h2 class="dh-card__name">{{weaponName}}</h2>
    <div class="dh-card__sub">{{attackerName}}{{#if manyTargets}} · {{answered}} of {{count}} answered{{#if allDone}} · {{totalWounds}} wounds{{#if totalCritical}} + {{totalCritical}} critical{{/if}} in total{{/if}}{{/if}}</div>
    <div class="dh-rule"></div>

    {{#each targets as |t|}}
        <section class="dh-target {{#if t.open}}is-open{{else}}is-done dh-target--{{t.verdict}}{{/if}}" data-uuid="{{t.uuid}}">
            <header class="dh-target__head">
                <b>{{t.name}}</b>
                <span class="dh-target__meta">{{t.hitCount}} hit{{#if t.manyHits}}s{{/if}}{{#if t.area}} · {{t.area.distance}} m from the centre{{/if}}</span>
                {{#unless t.open}}<span class="dh-target__badge">{{#if t.missed}}missed{{else if t.partial}}{{t.damage}} wounds{{else}}{{t.damage}} wounds{{/if}}</span>{{/unless}}
            </header>

            {{#if t.open}}
                {{#each t.notes as |n|}}<p class="dh-note">{{n}}</p>{{/each}}
                <footer class="dh-card__foot dh-card__foot--center dh-target__buttons">
                    {{#each t.choices as |c|}}
                        <button type="button" class="dh-btn dh-target__choice" data-choice="{{c.id}}">
                            <i class="fa-solid {{c.icon}}"></i><span>{{c.label}}{{#if c.target}} <small>({{c.target}})</small>{{/if}}</span>
                        </button>
                    {{/each}}
                </footer>
                <p class="dh-detail-line dh-target__wait"></p>
            {{else}}
                <p class="dh-detail-line">
                    {{#if t.tookHit}}Took the hit.{{else}}{{t.evasionText}}{{#if t.preventedText}} · {{t.preventedText}}{{/if}}{{/if}}
                    {{#if t.missed}} <b>The attack missed.</b>{{else}} <b>{{t.damage}} wounds</b>{{#if t.critical}} + <span class="warn">{{t.critical}} critical</span>{{/if}} · {{t.result.wounds}} / {{t.maxWounds}}{{/if}}
                </p>
                {{#unless t.missed}}
                    <details class="dh-target__details">
                        <summary>Damage calculation</summary>
                        {{#each t.result.hits as |h|}}
                            {{> "systems/dark-heresy-2nd/templates/chat/partials/damage-calc.hbs" h}}
                            {{#if h.criticalEffect}}<p class="dh-note dh-note--alert">{{h.criticalEffect}}</p>{{/if}}
                            {{#each h.fury as |f|}}<p class="dh-note dh-note--alert"><b>Righteous Fury</b> – {{f}}</p>{{/each}}
                        {{/each}}
                    </details>
                {{/unless}}
            {{/if}}
        </section>
    {{/each}}
</div>
