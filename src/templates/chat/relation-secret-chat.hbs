<div class="dh-ui dh-card dh-card--ornate {{#if success}}dh-card--success{{else}}dh-card--fail{{/if}}">
    <div class="dh-card__eyebrow">Skill</div>
    <h2 class="dh-card__name">{{skillLabel}}</h2>
    <div class="dh-card__sub">{{characterName}} · influence unknown</div>
    <div class="dh-rule"></div>
    <div class="dh-verdict {{#if success}}dh-verdict--success{{else}}dh-verdict--fail{{/if}}">{{#if success}}Success{{else}}Failure{{/if}}</div>
    <p class="dh-detail-line">{{degrees}} degrees of {{#if success}}success{{else}}failure{{/if}}</p>
    <p class="dh-note">The influence of the patron is not known to the player; the GM resolved the test.</p>
</div>
