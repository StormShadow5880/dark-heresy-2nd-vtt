<div class="dh-ui dh-card dh-card--fail">
    <header class="dh-card__head">
        <span class="dh-card__title">{{actor.name}}</span>
        <span class="dh-card__action">Bleeding!</span>
    </header>
    <div class="dh-card__body">
        <div class="dh-mods">
            <span class="dh-mod dh-mod--alert"><b>Fatigue</b> +1</span>
            <span class="dh-mod"><b>Fatigue now</b> {{actor.system.fatigue.value}} / {{actor.system.fatigue.max}}</span>
        </div>
        <p class="dh-note">Once per round as a Free Action, he (or another character who can reach him) can attempt a Difficult (–10) Medicae test to remove this condition.</p>
    </div>
    <footer class="dh-card__foot">
        <button type="button" class="dh-btn dh-btn--primary roll-control__apply-damage"
                data-uuid="{{actor.uuid}}"
                data-damage="0"
                data-fatigue="1">
            <i class="fa-solid fa-droplet"></i><span>Apply Fatigue</span>
        </button>
    </footer>
</div>
