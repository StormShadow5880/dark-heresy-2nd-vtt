<div class="dh-ui dh-card {{#unless rollData.ignoreSuccess}}{{#if rollData.success}}dh-card--success{{else}}dh-card--fail{{/if}}{{/unless}}">
    {{#with rollData}}
        <header class="dh-card__head">
            <span class="dh-card__title">{{name}}</span>
            {{#if action}}<span class="dh-card__action">{{action}}</span>{{/if}}
        </header>
        {{#if @root.label}}<p class="dh-card__sub">{{@root.label}}{{#if effectString}} · {{effectString}}{{/if}}</p>
        {{else if effectString}}<p class="dh-card__sub">{{effectString}}</p>{{/if}}
        <div class="dh-card__body">
            {{#unless ignoreSuccess}}
                <div class="dh-result {{#if success}}dh-result--success{{else}}dh-result--fail{{/if}}">
                    <span class="dh-result__roll" data-tooltip="Dice result (W100)">{{roll.total}}</span>
                    <span class="dh-result__main">
                        <span class="dh-status {{#if success}}dh-status--success{{else}}dh-status--fail{{/if}}">{{#if success}}Success{{else}}Failure{{/if}}</span>
                        <span class="dh-result__detail">
                            {{#unless ignoreModifiers}}Target {{modifiedTarget}}{{/unless}}
                            {{#unless ignoreDegrees}}{{#unless ignoreModifiers}} · {{/unless}}{{#if success}}{{dos}} DoS{{else}}{{dof}} DoF{{/if}}{{/unless}}
                        </span>
                    </span>
                </div>
            {{/unless}}

            {{#unless ignoreModifiers}}
                <div class="dh-mods">
                    <span class="dh-mod"><b>Base</b> {{baseTarget}}</span>
                    {{#each activeModifiers}}<span class="dh-mod"><b>{{@key}}</b> {{this}}</span>{{/each}}
                    <span class="dh-mod dh-mod--total"><b>Target</b> {{modifiedTarget}}</span>
                    {{#if usesAmmo}}<span class="dh-mod"><b>Ammo used</b> {{ammoUsed}}</span>{{/if}}
                </div>
            {{else}}
                {{#if usesAmmo}}<div class="dh-mods"><span class="dh-mod"><b>Ammo used</b> {{ammoUsed}}</span></div>{{/if}}
            {{/unless}}

            {{#if isOpposed}}
                <div class="dh-mods">
                    <span class="dh-mod"><b>Opposed {{opposedChar}}</b> {{opposedRoll.total}} vs {{opposedTarget}}{{#if opposedSuccess}} ({{opposedDos}}){{/if}}</span>
                </div>
            {{/if}}

            {{#each @root.effectOutput as |effect|}}
                <p class="dh-note"><b>{{effect.name}}</b> – {{effect.effect}}</p>
            {{/each}}
        </div>

        {{#unless ignoreControls}}
            <footer class="dh-card__foot">
                {{#if showDamage}}
                    <button type="button" class="dh-btn roll-control__hide-control" data-toggle="{{@root.id}}">
                        <i class="fa-solid fa-burst"></i><span>Damage</span>
                    </button>
                {{else}}
                    <button type="button" class="dh-btn" disabled>
                        <i class="fa-solid fa-burst"></i><span>Damage</span>
                    </button>
                {{/if}}
                <button type="button" class="dh-btn roll-control__refund" data-roll-id="{{@root.id}}">
                    <i class="fa-solid fa-rotate-left"></i><span>Refund</span>
                </button>
                <button type="button" class="dh-btn roll-control__fate-reroll" data-roll-id="{{@root.id}}">
                    <i class="fa-solid fa-dice"></i><span>Re-roll</span>
                </button>
            </footer>
        {{/unless}}
    {{/with}}

    {{#unless rollData.ignoreDamage}}
        {{#with damageData}}
            <div id="{{@root.id}}" class="dh-detail" style="display: none">
                {{#if @root.psychicEffect}}
                    <div class="dh-prose">{{{@root.psychicEffect}}}</div>
                {{/if}}
                {{#each hits as |hit|}}
                    <section class="dh-hit">
                        <h4 class="dh-hit__title">Hit {{inc @index}}<span>{{hit.location}}</span></h4>
                        <div class="dh-result dh-result--info">
                            <span class="dh-result__roll" data-tooltip="Total damage">{{hit.totalDamage}}</span>
                            <span class="dh-result__main">
                                <span class="dh-status dh-status--info">Damage</span>
                                <span class="dh-result__detail">{{hit.damageType}} · {{hit.location}} · Pen {{hit.totalPenetration}}</span>
                            </span>
                        </div>
                        <div class="dh-mods">
                            <span class="dh-mod"><b>Formula</b> {{hit.damageRoll.formula}}</span>
                            <span class="dh-mod"><b>Roll</b> {{hit.damageRoll.result}}</span>
                            {{#each modifiers}}<span class="dh-mod"><b>{{@key}}</b> {{this}}</span>{{/each}}
                            <span class="dh-mod"><b>Base Pen</b> {{#if hit.hasPenetrationRoll}}{{hit.penetrationRoll.result}}{{else}}{{hit.penetration}}{{/if}}</span>
                            {{#each penetrationModifiers}}<span class="dh-mod"><b>Pen {{@key}}</b> {{this}}</span>{{/each}}
                        </div>
                        {{#each hit.effects as |effect|}}
                            <p class="dh-note"><b>{{effect.name}}</b> – {{effect.effect}}</p>
                        {{/each}}
                        {{#each righteousFury as |fury|}}
                            <p class="dh-note dh-note--alert"><b>Righteous Fury</b> – level {{fury.roll.total}} critical effect. {{fury.effect}}</p>
                        {{/each}}
                        {{#if @root.rollData.targetActor}}
                            <div class="dh-card__foot">
                                <button type="button" class="dh-btn dh-btn--primary roll-control__assign-damage"
                                        data-location="{{hit.location}}"
                                        data-total-damage="{{hit.totalDamage}}"
                                        data-total-penetration="{{hit.totalPenetration}}"
                                        data-total-fatigue="{{hit.totalFatigue}}"
                                        data-target-uuid="{{@root.rollData.targetActor.uuid}}"
                                        data-damage-type="{{hit.damageType}}">
                                    <i class="fa-solid fa-crosshairs"></i><span>Assign Damage</span>
                                </button>
                            </div>
                        {{/if}}
                    </section>
                {{/each}}
            </div>
        {{/with}}
    {{/unless}}
</div>
