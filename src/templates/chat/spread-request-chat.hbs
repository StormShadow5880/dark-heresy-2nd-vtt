<div class="dh-ui dh-card dh-card--ornate dh-spread">
    <div class="dh-card__eyebrow">{{attackType}}</div>
    <h2 class="dh-card__name">{{powerName}}</h2>
    <div class="dh-card__sub">{{attackerName}} → {{targetName}} · {{hitCount}} hits</div>
    <div class="dh-rule"></div>
    <p class="dh-note">The first hit strikes {{targetName}}. Each further hit may strike {{targetName}} or any other target within {{range}} metres of them, as long as all targets are in range and line of sight. Click the button, then click the targets on the map with the left mouse button.</p>
    <footer class="dh-card__foot dh-card__foot--center dh-spread__buttons">
        <button type="button" class="dh-btn dh-btn--primary dh-spread__choose">
            <i class="fa-solid fa-bullseye"></i><span>Choose {{extraHits}} target{{#if manyExtra}}s{{/if}}</span>
        </button>
    </footer>
    <p class="dh-detail-line dh-spread__text"></p>
</div>
