<div class="dh-ui dh-card {{#if success}}dh-card--success{{else}}dh-card--fail{{/if}}">
    <header class="dh-card__head">
        <span class="dh-card__title">{{actor.name}}</span>
        <span class="dh-card__action">On Fire!</span>
    </header>
    <p class="dh-card__sub">On Fire damage ignores armour</p>
    <div class="dh-card__body">
        <div class="dh-result {{#if success}}dh-result--success{{else}}dh-result--fail{{/if}}">
            <span class="dh-result__roll" data-tooltip="Willpower test (W100)">{{roll.total}}</span>
            <span class="dh-result__main">
                <span class="dh-status {{#if success}}dh-status--success{{else}}dh-status--fail{{/if}}">{{#if success}}Willpower success{{else}}Willpower failure{{/if}}</span>
                <span class="dh-result__detail">Target {{target}}</span>
            </span>
        </div>
        <div class="dh-mods">
            <span class="dh-mod"><b>Energy damage</b> {{damage}}</span>
            <span class="dh-mod"><b>Fatigue</b> 1</span>
        </div>
        <p class="dh-note">{{#if success}}You may take actions as normal.{{else}}You can only flail in agony and scream.{{/if}}</p>
    </div>
    <footer class="dh-card__foot">
        <button type="button" class="dh-btn dh-btn--primary roll-control__apply-damage"
                data-type="Energy"
                data-ignore-armour="true"
                data-uuid="{{actor.uuid}}"
                data-damage="{{damage}}"
                data-fatigue="1">
            <i class="fa-solid fa-crosshairs"></i><span>Apply Damage</span>
        </button>
    </footer>
</div>
