<div class="dh-ui dh-card dh-card--ornate {{#if evaded}}dh-card--success{{else}}dh-card--fail{{/if}}">
    <div class="dh-card__eyebrow">{{attackerName}} · {{weaponName}}</div>
    <h2 class="dh-card__name">{{targetName}}</h2>
    <div class="dh-rule"></div>

    {{#if evasion}}
        <div class="dh-vs">
            <div class="dh-vs__value"><span>{{evasion.label}}</span><strong>{{evasion.roll}}</strong></div>
            <div class="dh-vs__sep">vs</div>
            <div class="dh-vs__value"><span>Target</span><strong>{{evasion.target}}</strong></div>
        </div>
        <div class="dh-verdict {{#if evasion.success}}dh-verdict--success{{else}}dh-verdict--fail{{/if}}">{{#if evasion.success}}{{evasion.label}} succeeded{{else}}{{evasion.label}} failed{{/if}}</div>
        {{#if evasion.success}}<p class="dh-detail-line">{{evasion.degrees}} degree{{#if multipleDegrees}}s{{/if}} of success: {{prevented}} of {{total}} hit{{#if manyHits}}s{{/if}} prevented.</p>{{/if}}
    {{/if}}

    {{#if evaded}}
        <p class="dh-detail-line">{{#if evasion}}All hits are prevented: the attack missed, no damage.{{else}}The attack is avoided, no damage.{{/if}}</p>
    {{else}}
        {{#if partial}}<p class="dh-note">{{prevented}} of {{total}} hits prevented, the others strike.</p>{{/if}}
        <div class="dh-badge dh-badge--damage" data-tooltip="Wounds taken"><span class="dh-badge__num">{{result.damage}}</span></div>
        <div class="dh-verdict dh-verdict--fail">{{#if result.damage}}wounds{{else}}no wounds{{/if}}</div>
        {{#each result.hits as |h|}}
            <section class="dh-calc">
                <h4 class="dh-calc__title">Hit · {{h.location}} <span>{{h.damageType}}</span></h4>
                <dl>
                    <div><dt>Damage</dt><dd>{{#if h.damageFormula}}{{h.damageFormula}} → {{h.damageDice}}{{#each h.damageModifiers as |m|}} {{m.text}} <small>{{m.name}}</small>{{/each}} = <b>{{h.rawDamage}}</b>{{else}}<b>{{h.rawDamage}}</b>{{/if}}</dd></div>
                    <div><dt>Armour</dt><dd>{{h.armour}} − penetration {{h.penetration}}{{#each h.penetrationModifiers as |m|}} <small>({{m.name}} {{m.text}})</small>{{/each}} = <b>{{h.usableArmour}}</b> <small>(not below 0)</small></dd></div>
                    <div><dt>Toughness bonus</dt><dd><b>{{h.toughnessBonus}}</b></dd></div>
                    <div><dt>Absorbed</dt><dd>{{h.usableArmour}} + {{h.toughnessBonus}} = <b>{{h.reduction}}</b></dd></div>
                    <div class="dh-calc__sum"><dt>Damage taken</dt><dd>{{h.rawDamage}} − {{h.reduction}} = <b>{{h.reducedDamage}}</b>{{#if h.critical}} → {{h.wounds}} wounds + <span class="warn">{{h.critical}} critical</span>{{else}} → <b>{{h.wounds}} wounds</b>{{/if}}</dd></div>
                    {{#if h.trueGrit}}<div><dt>True Grit</dt><dd>critical damage {{h.criticalBeforeGrit}} reduced by the toughness bonus (not below 1) = {{h.critical}}</dd></div>{{/if}}
                    <div><dt>Wounds</dt><dd>{{h.woundsBefore}} → <b>{{h.woundsAfter}}</b></dd></div>
                    {{#if h.fatigue}}<div><dt>Fatigue</dt><dd>+{{h.fatigue}}</dd></div>{{/if}}
                </dl>
            </section>
            {{#if h.criticalEffect}}<p class="dh-note dh-note--alert">{{h.criticalEffect}}</p>{{/if}}
            {{#each h.fury as |f|}}<p class="dh-note dh-note--alert"><b>Righteous Fury</b> – {{f}}</p>{{/each}}
        {{/each}}
        {{#if result.critical}}<div class="dh-mods dh-mods--center"><span class="dh-mod dh-mod--alert"><b>Critical damage</b> +{{result.critical}}</span></div>{{/if}}
        <div class="dh-mods dh-mods--center">
            <span class="dh-mod"><b>Wounds</b> {{result.wounds}} / {{maxWounds}}</span>
            <span class="dh-mod"><b>Critical</b> {{result.criticalTotal}}</span>
        </div>
    {{/if}}
</div>
