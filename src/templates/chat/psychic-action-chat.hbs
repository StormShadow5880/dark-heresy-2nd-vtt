<div class="dh-ui dh-card dh-card--ornate dh-card--psy {{#if rollData.success}}dh-card--success{{else}}dh-card--fail{{/if}}">
    {{#with rollData}}
        <div class="dh-card__eyebrow">{{#if action}}{{action}}{{else}}Psychic Power{{/if}}</div>
        <h2 class="dh-card__name">{{name}}</h2>
        {{#if @root.label}}<div class="dh-card__sub">{{@root.label}}{{#if effectString}} · {{effectString}}{{/if}}</div>
        {{else if effectString}}<div class="dh-card__sub">{{effectString}}</div>{{/if}}
        <div class="dh-rule"></div>
        <div class="dh-vs">
            <div class="dh-vs__value" data-tooltip="Dice result (W100)"><span>Roll</span><strong>{{roll.total}}</strong></div>
            <div class="dh-vs__sep">vs</div>
            <div class="dh-vs__value" data-tooltip="Base {{baseTarget}} with all modifiers"><span>Target</span><strong>{{modifiedTarget}}</strong></div>
        </div>
        <div class="dh-badge" data-tooltip="{{#if success}}Degrees of success{{else}}Degrees of failure{{/if}}"><span class="dh-badge__num">{{#if success}}+{{dos}}{{else}}−{{dof}}{{/if}}</span></div>
        <div class="dh-verdict {{#if success}}dh-verdict--success{{else}}dh-verdict--fail{{/if}}">{{#if success}}Success{{else}}Failure{{/if}}</div>
        <p class="dh-detail-line">{{#if success}}{{dos}} degrees of success{{else}}{{dof}} degrees of failure{{/if}}</p>
        <div class="dh-mods dh-mods--center">
            <span class="dh-mod"><b>Base</b> {{baseTarget}}</span>
            {{#each activeModifiers}}<span class="dh-mod"><b>{{@key}}</b> {{this}}</span>{{/each}}
        </div>
        {{#if isOpposed}}
            <div class="dh-mods dh-mods--center">
                <span class="dh-mod"><b>Opposed {{opposedChar}}</b> {{opposedRoll.total}} vs {{opposedTarget}}{{#if opposedSuccess}} ({{opposedDos}}){{/if}}</span>
            </div>
        {{/if}}
        {{#each @root.effectOutput as |effect|}}
            <p class="dh-note"><b>{{effect.name}}</b> – {{effect.effect}}</p>
        {{/each}}
        <div class="dh-rule"></div>
        <footer class="dh-card__foot dh-card__foot--center">
            {{#if success}}
                <button type="button" class="dh-btn roll-control__hide-control" data-toggle="{{@root.id}}">
                    <i class="fa-solid fa-eye"></i><span>Effect</span>
                </button>
            {{else}}
                <button type="button" class="dh-btn" disabled>
                    <i class="fa-solid fa-eye"></i><span>Effect</span>
                </button>
            {{/if}}
            <button type="button" class="dh-btn roll-control__fate-reroll" data-roll-id="{{@root.id}}">
                <i class="fa-solid fa-dice"></i><span>Re-roll</span>
            </button>
        </footer>
    {{/with}}
    {{#if rollData.success}}
        <div id="{{@root.id}}" class="dh-detail" style="display: none">
            <div class="dh-prose">{{{psychicEffect}}}</div>
        </div>
    {{/if}}
</div>
