<div class="dh-ui dh-card dh-card--ornate dh-defence" data-message-id="{{messageId}}">
    <div class="dh-card__eyebrow">Incoming attack</div>
    <h2 class="dh-card__name">{{targetName}}</h2>
    <div class="dh-card__sub">{{attackerName}} · {{weaponName}} · {{hitCount}} hit{{#if multiple}}s{{/if}}</div>
    <div class="dh-rule"></div>
    {{#each notes as |n|}}<p class="dh-note">{{n}}</p>{{/each}}
    <p class="dh-detail-line dh-defence__text">Choose how {{targetName}} reacts.</p>
    <footer class="dh-card__foot dh-card__foot--center dh-defence__buttons">
        {{#each choices as |c|}}
            <button type="button" class="dh-btn dh-defence__choice" data-choice="{{c.id}}">
                <i class="fa-solid {{c.icon}}"></i><span>{{c.label}}{{#if c.target}} <small>({{c.target}})</small>{{/if}}</span>
            </button>
        {{/each}}
    </footer>
</div>
